#!/bin/bash
# tool/ide_sync: put the Bazel-generated code into the checkout, git-ignored,
# so the IDE analyzer, `fvm flutter run`, the debugger and hot reload work on
# the real repo (T-0042, plan 03 KD11 and §7.1). Bazel stays the source of
# truth: nothing here is read by a Bazel build, and nothing here can be
# committed (the guards below refuse to write a file that git would pick up).
#
#   tool/ide_sync [--watch] [--link] [--env <env>] [--no-pub] [<package>...]
#
#   <package>    a package directory (feature/characters/characters_list); only
#                its codegen is synced. Default: every codegen target.
#   --env <env>  also write app/*/assets/app_config.json from
#                tool/bazel/config/<env>.json (R13) for the apps whose pubspec
#                declares it, and the Xcode project `flutter run` needs.
#   --link       symlink to the Bazel outputs instead of copying (A/B option;
#                the links point into this checkout's Bazel output base).
#   --watch      sync again whenever a Dart/ARB source changes (`fswatch` when
#                installed, polling every MC_IDE_SYNC_POLL seconds, default 2).
#   --no-pub     skip `fvm flutter pub get`.
#   --clean      delete every file in the manifest (and the manifest) and stop.
#
# What it does:
#   1. `bazel query` the codegen targets (dart_codegen, dart_aggregate_codegen,
#      flutter_gen_l10n; not the manual negative targets and not the BDD tests,
#      which only ever live in bazel-out) and `bazel build` them.
#   2. `bazel cquery --output=files` lists their outputs (the approach of
#      tool/e2e/prepare_pub_project.sh); only generated Dart is kept
#      (.g.dart, .freezed.dart, .config.dart, gen-l10n).
#   3. Guards, before anything is written: every target path must be git-ignored
#      and untracked, and one listed in the R28 fallback manifest is skipped.
#   4. Copies each output to <pkg>/<rel> only when its bytes differ.
#   5. Deletes files of the previous .dart_tool/mc_ide_sync.manifest that are
#      no longer produced (never a tracked file).
#   6. `fvm flutter pub get`.
#
# Environment:
#   MC_OUTPUT_BASE      Bazel output base (--output_base).
#   MC_IDE_SYNC_ROOT    tree to write into (default: this repo). Used by tests.
#   MC_IDE_SYNC_LIST    tests only: a file of "<absolute source>\t<relative dest>"
#                       lines replaces steps 1 and 2.
#   MC_IDE_SYNC_POLL    watch polling interval, seconds (default 2).
#   MC_IDE_SYNC_FALLBACK  the R28 fallback manifest (default
#                       tool/build_runner_overlay/fallback.yaml).
#   MC_IDE_SYNC_NO_IOS  set to skip the Xcode project bootstrap (tests).
#
# Exit codes: 0 synced, 1 a guard or step failed, 2 bad arguments.
# The last line printed is machine readable:
#   IDE_SYNC copied=<n> unchanged=<n> removed=<n> skipped=<n> total=<n>
set -uo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ROOT="${MC_IDE_SYNC_ROOT:-$REPO}"
MANIFEST="$ROOT/.dart_tool/mc_ide_sync.manifest"
FALLBACK="${MC_IDE_SYNC_FALLBACK:-$REPO/tool/build_runner_overlay/fallback.yaml}"
# The codegen outputs the IDE needs, as paths relative to the repo root.
GEN_RE='(\.g\.dart|\.freezed\.dart|\.config\.dart|/lib/src/l10n/[^/]*_l10n[^/]*\.dart)$'
KINDS='^(dart_codegen|dart_aggregate_codegen|flutter_gen_l10n) rule$'

WATCH=0 LINK=0 ENVNAME="" PUB=1 CLEAN=0
PKGS=()
while [ $# -gt 0 ]; do
  case $1 in
    --watch) WATCH=1; shift ;;
    --link) LINK=1; shift ;;
    --no-pub) PUB=0; shift ;;
    --clean) CLEAN=1; shift ;;
    --env)
      [ $# -ge 2 ] || { echo "ide_sync: --env needs a value" >&2; exit 2; }
      ENVNAME=$2; shift 2 ;;
    -h|--help) sed -n '2,45p' "${BASH_SOURCE[0]}"; exit 0 ;;
    -*) echo "ide_sync: unknown option $1" >&2; exit 2 ;;
    *) p=${1#//}; p=${p%/...}; p=${p%/}; PKGS+=("$p"); shift ;;
  esac
done
if [ -n "$ENVNAME" ] && [ ! -f "$REPO/tool/bazel/config/$ENVNAME.json" ]; then
  echo "ide_sync: no tool/bazel/config/$ENVNAME.json (environments: $(cd "$REPO/tool/bazel/config" && ls ./*.json | sed 's|./||;s|\.json||' | paste -sd' ' -))" >&2
  exit 2
fi
for p in ${PKGS[@]+"${PKGS[@]}"}; do
  [ -d "$ROOT/$p" ] || { echo "ide_sync: no package directory $p" >&2; exit 2; }
done

bzl() {
  local startup=()
  [ -z "${MC_OUTPUT_BASE:-}" ] || startup=("--output_base=$MC_OUTPUT_BASE")
  "$REPO/tool/bazelw" ${startup[@]+"${startup[@]}"} "$@"
}
log() { echo "ide_sync: $*" >&2; }
git_root() { git -C "$ROOT" "$@"; }

SCRATCH="$(mktemp -d)"
trap 'rm -rf "$SCRATCH"' EXIT

# --- 1 and 2: the list of "<absolute source>\t<relative dest>" ------------------
list_outputs() {  # list_outputs <out file>
  local out=$1
  if [ -n "${MC_IDE_SYNC_LIST:-}" ]; then
    cp "$MC_IDE_SYNC_LIST" "$out"
    return 0
  fi
  local scope
  if [ ${#PKGS[@]} -eq 0 ]; then
    scope="//..."
  else
    scope="(" ; local p
    for p in "${PKGS[@]}"; do scope="$scope //$p/... +"; done
    scope="${scope% +} )"
  fi
  local expr="let c = kind(\"$KINDS\", $scope) in \$c except attr(tags, \"manual\", \$c)"
  log "query: codegen targets under ${PKGS[*]:-the workspace}"
  bzl query "$expr" --output=label 2>"$SCRATCH/query.err" >"$SCRATCH/labels.txt" ||
    { cat "$SCRATCH/query.err" >&2; return 1; }
  [ -s "$SCRATCH/labels.txt" ] || { log "no codegen target under ${PKGS[*]:-the workspace}"; : >"$out"; return 0; }
  log "build: $(wc -l <"$SCRATCH/labels.txt" | tr -d ' ') codegen targets"
  bzl build --remote_download_outputs=all --keep_going --target_pattern_file="$SCRATCH/labels.txt" \
    >/dev/null 2>"$SCRATCH/build.err" || { tail -30 "$SCRATCH/build.err" >&2; return 1; }
  { printf 'set('; tr '\n' ' ' <"$SCRATCH/labels.txt"; printf ')\n'; } >"$SCRATCH/set.query"
  bzl cquery --query_file="$SCRATCH/set.query" --output=files \
    2>"$SCRATCH/cquery.err" >"$SCRATCH/files.txt" || { cat "$SCRATCH/cquery.err" >&2; return 1; }
  local exec
  exec="$(bzl info execution_root 2>/dev/null)" || return 1
  # bazel-out/<config>/bin/<rel>: keep the generated Dart, once per path.
  sed -n 's|^bazel-out/[^/]*/bin/||p' "$SCRATCH/files.txt" | grep -E "$GEN_RE" | grep -v '^external/' | sort -u |
    while IFS= read -r rel; do
      src="$(ls -d "$exec"/bazel-out/*/bin/"$rel" 2>/dev/null | head -1)"
      [ -f "$src" ] || { echo "ide_sync: Bazel did not produce $rel" >&2; echo MISSING >"$SCRATCH/missing"; continue; }
      printf '%s\t%s\n' "$src" "$rel"
    done >"$out"
  [ ! -e "$SCRATCH/missing" ]
}

# --- helpers ------------------------------------------------------------------
in_scope() {  # in_scope <rel>: true when the sync covers this path
  [ ${#PKGS[@]} -eq 0 ] && return 0
  local p
  for p in "${PKGS[@]}"; do case $1 in "$p"/*) return 0 ;; esac; done
  return 1
}
fallback_paths() {  # the R28 manifest: every list item that looks like a path
  [ -f "$FALLBACK" ] || return 0
  sed -n 's/^[[:space:]]*-[[:space:]]*"\{0,1\}\([A-Za-z0-9_./-]*\/[A-Za-z0-9_./-]*\)"\{0,1\}[[:space:]]*$/\1/p' "$FALLBACK"
}
is_tracked() { [ -n "$(git_root ls-files -- "$1")" ]; }
is_ignored() { git_root check-ignore -q --no-index -- "$1"; }

# place <src> <rel>: copy (or link) when different; prints C (changed) or U.
place() {
  local src=$1 rel=$2 dest="$ROOT/$2"
  if [ "$LINK" = 1 ]; then
    if [ -L "$dest" ] && [ "$(readlink "$dest")" = "$src" ]; then echo U; return 0; fi
    mkdir -p "$(dirname "$dest")"
    ln -sfn "$src" "$dest.tmp.$$" && mv -f "$dest.tmp.$$" "$dest"
  else
    if [ -f "$dest" ] && [ ! -L "$dest" ] && cmp -s "$src" "$dest"; then echo U; return 0; fi
    mkdir -p "$(dirname "$dest")"
    # Bazel outputs are read-only; copy to a temp name and rename, so a watcher
    # never sees a half-written file.
    cp "$src" "$dest.tmp.$$" && chmod u+w "$dest.tmp.$$" && mv -f "$dest.tmp.$$" "$dest"
  fi
  echo C
}

# --- the sync -----------------------------------------------------------------
sync_once() {
  local list="$SCRATCH/list.tsv" want="$SCRATCH/want.txt" fb="$SCRATCH/fallback.txt"
  : >"$list"
  list_outputs "$list" || { log "could not list the Bazel outputs"; return 1; }
  fallback_paths | sort -u >"$fb"

  # The config assets are part of the same list (so guards, manifest and stale
  # removal treat them alike).
  if [ -n "$ENVNAME" ]; then
    local pubspec appdir
    while IFS= read -r pubspec; do
      grep -q 'assets/app_config.json' "$pubspec" || continue
      appdir="$(dirname "${pubspec#"$ROOT"/}")"
      in_scope "$appdir/assets/app_config.json" || continue
      printf '%s\t%s\n' "$REPO/tool/bazel/config/$ENVNAME.json" "$appdir/assets/app_config.json" >>"$list"
    done < <(find "$ROOT/app" -name pubspec.yaml -not -path '*/.dart_tool/*' -not -path '*/build/*' 2>/dev/null | sort)
  fi

  # Guards first: no write happens unless every path passes.
  local src rel bad=0
  : >"$want"
  while IFS=$'\t' read -r src rel; do
    [ -n "$rel" ] || continue
    if grep -qxF "$rel" "$fb"; then
      log "skip $rel (R28 fallback manifest: committed, not synced)"
      echo "$rel" >>"$SCRATCH/skipped"; continue
    fi
    if is_tracked "$rel"; then log "REFUSED: $rel is tracked by git"; bad=1; continue; fi
    if ! is_ignored "$rel"; then log "REFUSED: $rel is not git-ignored, so a commit would pick it up"; bad=1; continue; fi
    printf '%s\t%s\n' "$src" "$rel" >>"$want"
  done <"$list"
  [ "$bad" = 0 ] || { log "nothing was written"; return 1; }

  local copied=0 unchanged=0 removed=0 skipped=0 r
  [ ! -f "$SCRATCH/skipped" ] || skipped=$(wc -l <"$SCRATCH/skipped" | tr -d ' ')
  while IFS=$'\t' read -r src rel; do
    r="$(place "$src" "$rel")" || { log "failed to write $rel"; return 1; }
    if [ "$r" = C ]; then copied=$((copied + 1)); else unchanged=$((unchanged + 1)); fi
  done <"$want"
  cut -f2 "$want" | sort -u >"$SCRATCH/now.txt"

  # Stale: in the old manifest, in scope, not produced now. Without --env the
  # config assets are not part of this run, so they are carried over.
  local old="$SCRATCH/old.txt" keep="$SCRATCH/keep.txt"
  if [ -f "$MANIFEST" ]; then sort -u "$MANIFEST" >"$old"; else : >"$old"; fi
  : >"$keep"
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    if grep -qxF "$rel" "$SCRATCH/now.txt"; then continue; fi
    if ! in_scope "$rel" || { [ -z "$ENVNAME" ] && case $rel in */assets/app_config.json) true ;; *) false ;; esac; }; then
      echo "$rel" >>"$keep"; continue
    fi
    if is_tracked "$rel"; then log "not deleting $rel: it is tracked"; continue; fi
    if [ -e "$ROOT/$rel" ] || [ -L "$ROOT/$rel" ]; then rm -f "$ROOT/$rel"; removed=$((removed + 1)); log "removed $rel (no longer generated)"; fi
  done <"$old"
  mkdir -p "$(dirname "$MANIFEST")"
  cat "$SCRATCH/now.txt" "$keep" | sort -u >"$SCRATCH/manifest.new"
  if [ ! -f "$MANIFEST" ] || ! cmp -s "$SCRATCH/manifest.new" "$MANIFEST"; then cp "$SCRATCH/manifest.new" "$MANIFEST"; fi

  local total
  total=$(wc -l <"$SCRATCH/now.txt" | tr -d ' ')
  rm -f "$SCRATCH/skipped" "$SCRATCH/missing"
  SUMMARY="IDE_SYNC copied=$copied unchanged=$unchanged removed=$removed skipped=$skipped total=$total"
  return 0
}

# The Xcode project: apps carry only the Bazel runner files, so `flutter run`
# needs one from `flutter create` (F-0032). It is created in a scratch copy and
# only the missing, git-ignored scaffolding is copied in; no tracked file changes.
ensure_ios_project() {
  [ -z "${MC_IDE_SYNC_NO_IOS:-}" ] || return 0
  local pubspec appdir name tmp item
  while IFS= read -r pubspec; do
    grep -q 'assets/app_config.json' "$pubspec" || continue
    appdir="$(dirname "$pubspec")"
    [ -f "$appdir/ios/Runner/Info.plist" ] || continue
    in_scope "${appdir#"$ROOT"/}/x" || continue
    [ ! -d "$appdir/ios/Runner.xcodeproj" ] || continue
    name="$(basename "$appdir")"
    log "flutter create --platforms=ios for $name (Xcode project, git-ignored)"
    tmp="$SCRATCH/ios-$name"; mkdir -p "$tmp/$name"
    cp -R "$appdir/ios" "$appdir/pubspec.yaml" "$tmp/$name/"
    (cd "$tmp/$name" && fvm flutter create --platforms=ios --project-name "$name" --org com.emiliev --no-pub . >/dev/null 2>"$SCRATCH/create.err") ||
      { cat "$SCRATCH/create.err" >&2; return 1; }
    for item in Runner.xcodeproj Runner.xcworkspace RunnerTests Flutter/AppFrameworkInfo.plist Flutter/Debug.xcconfig Flutter/Release.xcconfig; do
      [ -e "$tmp/$name/ios/$item" ] || continue
      [ ! -e "$appdir/ios/$item" ] || continue
      mkdir -p "$(dirname "$appdir/ios/$item")"
      cp -R "$tmp/$name/ios/$item" "$appdir/ios/$item"
      is_ignored "${appdir#"$ROOT"/}/ios/$item" || { log "REFUSED: ${appdir#"$ROOT"/}/ios/$item would be committable"; return 1; }
    done
  done < <(find "$ROOT/app" -name pubspec.yaml -not -path '*/.dart_tool/*' -not -path '*/build/*' 2>/dev/null | sort)
}

run_once() {
  SUMMARY=""
  sync_once || return 1
  if [ -n "$ENVNAME" ]; then ensure_ios_project || return 1; fi
  if [ "$PUB" = 1 ]; then
    (cd "$ROOT" && fvm flutter pub get >"$SCRATCH/pub.out" 2>&1) ||
      { tail -20 "$SCRATCH/pub.out" >&2; log "fvm flutter pub get failed"; return 1; }
  fi
  echo "$SUMMARY"
}

if [ "$CLEAN" = 1 ]; then
  n=0
  if [ -f "$MANIFEST" ]; then
    while IFS= read -r rel; do
      [ -n "$rel" ] || continue
      in_scope "$rel" || continue
      if is_tracked "$rel"; then log "not deleting $rel: it is tracked"; continue; fi
      if [ -e "$ROOT/$rel" ] || [ -L "$ROOT/$rel" ]; then rm -f "$ROOT/$rel"; n=$((n + 1)); fi
    done <"$MANIFEST"
    if [ ${#PKGS[@]} -eq 0 ]; then rm -f "$MANIFEST"; fi
  fi
  echo "IDE_SYNC cleaned=$n"
  exit 0
fi

if [ "$WATCH" = 0 ]; then
  run_once
  exit $?
fi

# --- watch ----------------------------------------------------------------------
# Sources that make codegen output change: Dart, ARB, pubspec and BUILD files,
# outside generated or build directories.
fingerprint() {
  (cd "$ROOT" && find app feature utility spike third_party tool -type f \
      \( -name '*.dart' -o -name '*.arb' -o -name 'BUILD.bazel' -o -name '*.bzl' \) \
      -not -name '*.g.dart' -not -name '*.freezed.dart' -not -name '*.config.dart' \
      -not -path '*/.dart_tool/*' -not -path '*/build/*' -not -path '*/ios/*' \
      -not -path '*/lib/src/l10n/*_l10n*.dart' \
      -exec stat -f '%N %m %z' {} + 2>/dev/null | sort | shasum | cut -d' ' -f1)
}
log "watching (Ctrl-C to stop)"
run_once || log "initial sync failed; still watching"
last="$(fingerprint)"
POLL="${MC_IDE_SYNC_POLL:-2}"
while true; do
  if command -v fswatch >/dev/null 2>&1; then
    # One event batch, then sync. -o coalesces; the latency avoids a storm on save.
    (cd "$ROOT" && fswatch -1 -o -l 0.5 -e '/\.dart_tool/' -e '/build/' -e '\.g\.dart$' -e '\.freezed\.dart$' -e '\.config\.dart$' \
        app feature utility spike third_party tool >/dev/null 2>&1) || sleep "$POLL"
  else
    sleep "$POLL"
  fi
  now="$(fingerprint)"
  [ "$now" != "$last" ] || continue
  last="$now"
  log "source change detected"
  run_once || log "sync failed; still watching"
done
