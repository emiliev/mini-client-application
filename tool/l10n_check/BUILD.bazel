load("@rules_dart//dart:defs.bzl", "dart_binary", "dart_library", "dart_test")

dart_library(
    name = "l10n_check",
    srcs = glob(["lib/**/*.dart"]),
    language_version = "3.13",
    package_name = "l10n_check",
    visibility = ["//visibility:public"],
)

# tool/bazelw run //tool/l10n_check:bin   (checks every package's ARB set)
dart_binary(
    name = "bin",
    language_version = "3.13",
    main = "bin/l10n_check.dart",
    package_name = "l10n_check",
    deps = [":l10n_check"],
)

# The gate over the real ARB sets. Every package that gets ARBs exports an
# `arbs` filegroup and adds it here.
dart_test(
    name = "workspace_gate_test",
    size = "small",
    data = [
        "//feature/characters/characters_list:arbs",
        "//feature/comics/comics_details:arbs",
        "//feature/discovery/discovery_search:arbs",
        "//feature/library/library_reading_list_editor:arbs",
        "//feature/store/store_home:arbs",
        "//feature/trivia/trivia_quiz:arbs",
        "//utility/mc_l10n_core:arbs",
    ],
    language_version = "3.13",
    main = "test/workspace_gate_test.dart",
    package_name = "l10n_check",
    deps = [
        ":l10n_check",
        "@pub_deps//:test",
    ],
)

dart_test(
    name = "l10n_check_test",
    size = "small",
    language_version = "3.13",
    main = "test/l10n_check_test.dart",
    package_name = "l10n_check",
    deps = [
        ":l10n_check",
        "@pub_deps//:test",
    ],
)
