{{{build_preamble}}}load("@rules_dart//dart:defs.bzl", "dart_codegen", "dart_library", "dart_test")
load("@rules_dart//dart/ext/injectable:defs.bzl", "injectable_package")
load("@rules_flutter//flutter:defs.bzl", "flutter_gen_l10n", "flutter_library", "flutter_test")
load("//tool/bazel:defs.bzl", "MC_GENERATED_DART", "mc_bdd_tests")

package(default_visibility = ["//visibility:private"])

_PKG = "{{{name}}}"

_LANG = "{{{lang}}}"  # the pubspec floor; codegen equals build_runner only with it (F-0011)

_INIT = "lib/src/di/di_initializer.dart"

# Pure-Dart deps of the hand-written, generator-read files.
_PURE_DEPS = [
{{#pure_deps}}
    "{{{label}}}",
{{/pure_deps}}
]

# The Flutter-free hand-written files: domain, navigator, flow state, blocs and
# the root-import list. Pages, widgets, the flow widget and l10n are Flutter.
_PURE_SRCS = glob(
    [
        "lib/src/di/flow_scope.dart",
        "lib/src/domain/**/*.dart",
        "{{{flow_state_src}}}",
        "lib/src/navigator/**/*.dart",
        "lib/src/presentation/bloc/**/*.dart",
    ],
    exclude = MC_GENERATED_DART,
)

# Generator input only (V3-18): never a dep of the package library or a test.
dart_library(
    name = "_stage",
    package_name = _PKG,
    srcs = _PURE_SRCS,
    language_version = _LANG,
    tags = [
        "no-dart-analyze",
        "no-dart-format",
    ],
    deps = _PURE_DEPS,
)

# --- freezed ----------------------------------------------------------------
_FREEZED = {
{{#freezed}}
    "{{{name}}}": "{{{src}}}",
{{/freezed}}
}

[dart_codegen(
    name = "_%s_freezed" % name,
    package_name = _PKG,
    src = src,
    generator_bin = "@rules_dart//dart/ext/freezed:shim",
    language_version = _LANG,
    output_suffixes = [".freezed.dart"],
    # The DTO imports only annotations, so its lane stays narrow.
    deps = [
        "@pub_deps//:freezed_annotation",
        "@pub_deps//:json_annotation",
    ] if name == "{{{dto_name}}}" else [":_stage"],
) for name, src in _FREEZED.items()]

{{{dto_rule}}}
dart_library(
    name = "_stage_dto",
    package_name = _PKG,
    srcs = [
        "{{{dto_src}}}",
        ":_{{{dto_name}}}_freezed",
    ],
    language_version = _LANG,
    # The json part comes in the next stage, so this library doesn't analyze.
    tags = [
        "no-dart-analyze",
        "no-dart-format",
    ],
    deps = [
        "@pub_deps//:freezed_annotation",
        "@pub_deps//:json_annotation",
    ],
)

dart_codegen(
    name = "_{{{dto_name}}}_json_part",
    package_name = _PKG,
    src = "{{{dto_src}}}",
    generator_bin = "@rules_dart//dart/ext/json_serializable:shim",
    language_version = _LANG,
    output_suffixes = [".json_serializable.g.part"],
    deps = [":_stage_dto"],
)

dart_codegen(
    name = "_{{{dto_name}}}_g",
    package_name = _PKG,
    src = "{{{dto_src}}}",
    generator_bin = "@rules_dart//dart/ext/_shared/combining_shim:bin",
    language_version = _LANG,
    output_suffixes = [".g.dart"],
    parts = [":_{{{dto_name}}}_json_part"],
)

{{{api_rule}}}
dart_codegen(
    name = "_{{{api_name}}}_retrofit_part",
    package_name = _PKG,
    src = "{{{api_src}}}",
    generator_bin = "@rules_dart//dart/ext/retrofit:shim",
    language_version = _LANG,
    output_suffixes = [".retrofit.g.part"],
    deps = [
        ":_stage_dto",
        "@pub_deps//:dio",
        "@pub_deps//:injectable",
        "@pub_deps//:retrofit",
    ],
)

dart_codegen(
    name = "_{{{api_name}}}_g",
    package_name = _PKG,
    src = "{{{api_src}}}",
    generator_bin = "@rules_dart//dart/ext/_shared/combining_shim:bin",
    language_version = _LANG,
    output_suffixes = [".g.dart"],
    parts = [":_{{{api_name}}}_retrofit_part"],
)

# --- injectable (fork patch 0002) -------------------------------------------
injectable_package(
    name = "di_config",
    srcs = [
{{#injectable}}
        "{{{src}}}",
{{/injectable}}
    ],
    init = _INIT,
    init_deps = ["//utility/mc_di"],
    language_version = _LANG,
    package_name = _PKG,
    shard_deps = [":_stage"],
)

# --- gen-l10n ---------------------------------------------------------------
# Outputs land beside the ARBs; the rule ignores l10n.yaml, so these attributes
# mirror it (IDE / pub path: `flutter: generate: true`, F-0023).
flutter_gen_l10n(
    name = "_l10n",
    arbs = glob(["lib/src/l10n/*.arb"]),
    nullable_getter = False,
    output_class = "{{{l10n_class}}}",
    output_localization_file = "{{{name}}}_l10n.dart",
    template_arb_file = "{{{name}}}_en.arb",
)

filegroup(
    name = "arbs",
    srcs = glob(["lib/src/l10n/*.arb"]),
    visibility = ["//tool/l10n_check:__pkg__"],
)

_CODEGEN = [
{{#codegen}}
    "{{{target}}}",
{{/codegen}}
]

# --- the package library ----------------------------------------------------
_FLUTTER_DEPS = [
{{#flutter_deps}}
    "{{{label}}}",
{{/flutter_deps}}
]

flutter_library(
    name = "{{{name}}}",
    srcs = glob(
        ["lib/**/*.dart"],
        # `tool/ide_sync` and `fvm flutter pub get` write the generated files
        # beside their sources for the IDE; Bazel builds its own copies.
        exclude = MC_GENERATED_DART,
    ) + _CODEGEN,
    language_version = _LANG,
    package_name = _PKG,
    visibility = ["//visibility:public"],
    deps = _PURE_DEPS + _FLUTTER_DEPS,
)

{{{tests_rule}}}
_TEST_DEPS = [
{{#test_deps}}
    "{{{label}}}",
{{/test_deps}}
]

mc_bdd_tests(
    name = "bdd_test",
    data = ["//utility/mc_fixtures_media:asset_files"],
    features = glob(["test/feature/*.feature"]),
    language_version = _LANG,
    lib = ":{{{name}}}",
    package_name = _PKG,
    setup = "{{{env}}}",
    steps = glob([
        "test/feature/step/**/*.dart",
        "test/feature/util/*.dart",
    ]),
    deps = _TEST_DEPS,
)

{{#contracts}}
{{{comment}}}
flutter_test(
    name = "{{{name}}}",
    size = "small",
    language_version = _LANG,
    main = "{{{main}}}",
    package_name = _PKG,
    deps = [
{{#deps}}
        "{{{label}}}",
{{/deps}}
    ],
)

{{/contracts}}
# R17: the hand-written root imports resolve every registration of the flow.
flutter_test(
    name = "flow_scope_test",
    size = "small",
    srcs = glob(["test/feature/util/*.dart"]),
    data = [
        "//utility/mc_ds_theme:fonts",
        "//utility/mc_fixtures_media:asset_files",
    ],
    language_version = _LANG,
    main = "test/flow_scope_test.dart",
    package_name = _PKG,
    deps = _TEST_DEPS + [
{{#flow_scope_deps}}
        "{{{label}}}",
{{/flow_scope_deps}}
    ],
)
{{#legacy_goldens}}

flutter_test(
    name = "golden_test",
    size = "small",
    srcs = glob(["test/feature/util/*.dart"]),
    data = [
        "//utility/mc_ds_theme:fonts",
        "//utility/mc_fixtures_media:asset_files",
    ] + glob(["test/golden/goldens/**"], allow_empty = True),
    language_version = _LANG,
    main = "{{{golden_main}}}",
    package_name = _PKG,
    tags = ["golden"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = _TEST_DEPS + [
        ":{{{name}}}",
        "//utility/mc_test_utils",
        "@pub_deps//:flutter",
        "@pub_deps//:flutter_test",
    ],
)
{{/legacy_goldens}}

# R4 and R15 conformance. The list of generator-read files is written from the
# same glob as :_stage, so the check cannot drift from the staging library.
genrule(
    name = "_pure_srcs_list",
    outs = ["test/architecture/pure_srcs.txt"],
    cmd = "cat > $@ <<'EOF'\n" + "\n".join(_PURE_SRCS) + "\nEOF",
)

dart_test(
    name = "architecture_test",
    size = "small",
    data = [
        "lib/{{{name}}}.dart",
        ":_pure_srcs_list",
    ] + _PURE_SRCS,
    language_version = _LANG,
    main = "test/architecture/architecture_test.dart",
    package_name = _PKG,
    deps = ["@pub_deps//:test"],
)
