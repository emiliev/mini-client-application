# T-0028 sample: DI registrations generated by the injectable two-stage shim
# (rules_dart fork patch 0002, plan 03 §4.2, P3-04).
#
#   stage 1  one shard per annotated file    lib/src/<file>.injectable.json
#   stage 2  :di_config (aggregate)           lib/src/di/di_initializer.config.dart
#
# :di_config's deps are only what di_initializer.dart imports (injectable,
# get_it, mc_di), never :_stage, so a body edit that leaves every shard
# byte-identical is a cache hit for the aggregate (V3-04, T-0028-AC2).
load("@rules_dart//dart:defs.bzl", "dart_library", "dart_test")
load("@rules_dart//dart/ext/injectable:defs.bzl", "injectable_config", "injectable_package")

package(default_visibility = ["//visibility:private"])

_PKG = "di_sample"

# The pubspec's SDK floor (^3.13.0); codegen output equals build_runner's only
# with it set (F-0011).
_LANG = "3.13"

_INIT = "lib/src/di/di_initializer.dart"

_HAND_WRITTEN = glob(
    ["lib/**/*.dart"],
    exclude = ["lib/**/*.config.dart"],
)

# Files the annotation scan marks injectable. plain_helper.dart matches only
# in a comment, so its shard is `[]` (T-0028-AC4).
_INJECTABLE = [
    "lib/src/badge.dart",
    "lib/src/clock.dart",
    "lib/src/greeter.dart",
    "lib/src/greeting_repository.dart",
    "lib/src/plain_helper.dart",
    "lib/src/sample_module.dart",
]

_RUNTIME_DEPS = [
    "@pub_deps//:dio",
    "//utility/mc_di",
    "@pub_deps//:get_it",
    "@pub_deps//:injectable",
]

# Hand-written sources staged for the shard actions only (V3-18): never a dep
# of another library, test or of :di_config.
#
# The barrel (lib/di_sample.dart) is staged on purpose, but the init file it
# exports is not (that file imports the generated .config.dart, which doesn't
# exist at shard time). The dangling export is harmless: the analyzer resolves
# it to an empty library, so the build_runner-order walk in the shim
# (BuildRunnerLibrariesResolver, F-0028) reaches nothing extra through it, and
# an annotated file never imports the barrel. Proved by T-0028-AC1: with this
# _stage, .config.dart and all shards equal build_runner's, and every import
# is package:di_sample/src/<file>.dart, not the barrel.
dart_library(
    name = "_stage",
    package_name = _PKG,
    srcs = [s for s in _HAND_WRITTEN if s != _INIT],
    language_version = _LANG,
    tags = ["no-dart-analyze", "no-dart-format"],
    deps = _RUNTIME_DEPS,
)

injectable_package(
    name = "di_config",
    srcs = _INJECTABLE,
    init = _INIT,
    package_name = _PKG,
    language_version = _LANG,
    shard_deps = [":_stage"],
    init_deps = ["//utility/mc_di"],
)

dart_library(
    name = "di_sample",
    package_name = _PKG,
    srcs = _HAND_WRITTEN + [":di_config"],
    language_version = _LANG,
    visibility = ["//visibility:public"],
    deps = _RUNTIME_DEPS,
)

dart_test(
    name = "di_sample_test",
    size = "small",
    package_name = _PKG,
    language_version = _LANG,
    main = "test/di_sample_test.dart",
    deps = [
        ":di_sample",
        "//utility/mc_di",
        "@pub_deps//:get_it",
        "@pub_deps//:test",
    ],
)

# T-0028-AC4, negative case: without package:injectable in deps the
# @InjectableInit annotation doesn't resolve and generation yields nothing.
# The build must fail instead of writing an empty .config.dart:
#   tool/bazelw build //spike/di_sample:di_config_unresolved_init   (expected to FAIL)
injectable_config(
    name = "di_config_unresolved_init",
    init = _INIT,
    shards = [],
    package_name = _PKG,
    language_version = _LANG,
    annotation_deps = ["@pub_deps//:get_it"],
    output = "lib/src/di/unresolved/di_initializer.config.dart",
    tags = ["manual"],
)

# T-0028-AC4, negative case 2: the init file has no @InjectableInit, so the
# generator emits nothing; the shim fails naming the file (an unpatched shim
# would write an empty .config.dart):
#   tool/bazelw build //spike/di_sample:di_config_without_init   (expected to FAIL)
injectable_config(
    name = "di_config_without_init",
    init = "testdata/di_without_init.dart",
    shards = [],
    package_name = _PKG,
    language_version = _LANG,
    tags = ["manual"],
)
