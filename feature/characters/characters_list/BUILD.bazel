# T-0032 (P1-17): `characters_list`, the LD exemplar feature (plan 01 §3.3).
# Phase D's buildgen emits this file; until then it is written by hand.
#
# Every generator runs as a Bazel action; nothing generated is committed:
#   freezed      character, character_dto, flow state, list bloc (state part)
#   json         character_dto                  (over its freezed output)
#   retrofit     characters_list_api            (fork patch 0001)
#   injectable   4 shards + di_initializer.config.dart (fork patch 0002)
#   gen-l10n     lib/src/l10n/characters_list_l10n*.dart
#   BDD          test/feature/*.feature -> :bdd_test (fork patch 0003)
#
# Staging (plan 03 §3.4, §4.7). Generators read only Flutter-free libraries
# (R15): `_stage` holds the hand-written pure files. Two lanes are narrower so
# that a body edit in the bloc re-runs neither the retrofit part nor the
# injectable aggregate (T-0032-AC6):
#   - the retrofit and json actions see only the DTO and its freezed output
#     (`_stage_dto`), never `_stage`;
#   - the injectable aggregate sees only the init file and the shards; a bloc
#     edit re-runs the shards (all of them, F-0028 §5) but they come out
#     byte-identical, so the aggregate is an action-cache hit.
load("@rules_dart//dart:defs.bzl", "dart_codegen", "dart_library", "dart_test")
load("@rules_dart//dart/ext/injectable:defs.bzl", "injectable_package")
load("@rules_flutter//flutter:defs.bzl", "flutter_gen_l10n", "flutter_library", "flutter_test")
load("//tool/bazel:defs.bzl", "mc_bdd_tests")

package(default_visibility = ["//visibility:private"])

_PKG = "characters_list"

_LANG = "3.13"  # the pubspec floor; codegen equals build_runner only with it (F-0011)

_INIT = "lib/src/di/di_initializer.dart"

# Pure-Dart deps of the hand-written, generator-read files.
_PURE_DEPS = [
    "//utility/mc_api_client",
    "//utility/mc_api_errors",
    "//utility/mc_bloc_kit",
    "//utility/mc_di",
    "//utility/mc_media",
    "//utility/mc_monitoring",
    "//utility/mc_paging",
    "//utility/mc_prelude",
    "@pub_deps//:bloc",
    "@pub_deps//:dio",
    "@pub_deps//:freezed_annotation",
    "@pub_deps//:get_it",
    "@pub_deps//:injectable",
    "@pub_deps//:json_annotation",
    "@pub_deps//:retrofit",
]

# The Flutter-free hand-written files: domain, navigator, flow state, blocs and
# the root-import list. Pages, widgets, the flow widget and l10n are Flutter.
_PURE_SRCS = glob(
    [
        "lib/src/di/flow_scope.dart",
        "lib/src/domain/**/*.dart",
        "lib/src/flow/characters_list_flow_state.dart",
        "lib/src/navigator/**/*.dart",
        "lib/src/presentation/bloc/**/*.dart",
    ],
    exclude = [
        "**/*.g.dart",
        "**/*.freezed.dart",
    ],
)

# Generator input only (V3-18): never a dep of the package library or a test.
dart_library(
    name = "_stage",
    package_name = _PKG,
    srcs = _PURE_SRCS,
    language_version = _LANG,
    tags = [
        "no-dart-analyze",
        "no-dart-format",
    ],
    deps = _PURE_DEPS,
)

# --- freezed ----------------------------------------------------------------
_FREEZED = {
    "character": "lib/src/domain/model/character.dart",
    "character_dto": "lib/src/domain/model/character_dto.dart",
    "flow_state": "lib/src/flow/characters_list_flow_state.dart",
    "list_bloc": "lib/src/presentation/bloc/characters_list_bloc.dart",
}

[dart_codegen(
    name = "_%s_freezed" % name,
    package_name = _PKG,
    src = src,
    generator_bin = "@rules_dart//dart/ext/freezed:shim",
    language_version = _LANG,
    output_suffixes = [".freezed.dart"],
    # The DTO imports only annotations, so its lane stays narrow.
    deps = [
        "@pub_deps//:freezed_annotation",
        "@pub_deps//:json_annotation",
    ] if name == "character_dto" else [":_stage"],
) for name, src in _FREEZED.items()]

# --- character_dto: json over the freezed output ----------------------------
dart_library(
    name = "_stage_dto",
    package_name = _PKG,
    srcs = [
        "lib/src/domain/model/character_dto.dart",
        ":_character_dto_freezed",
    ],
    language_version = _LANG,
    # The json part comes in the next stage, so this library doesn't analyze.
    tags = [
        "no-dart-analyze",
        "no-dart-format",
    ],
    deps = [
        "@pub_deps//:freezed_annotation",
        "@pub_deps//:json_annotation",
    ],
)

dart_codegen(
    name = "_character_dto_json_part",
    package_name = _PKG,
    src = "lib/src/domain/model/character_dto.dart",
    generator_bin = "@rules_dart//dart/ext/json_serializable:shim",
    language_version = _LANG,
    output_suffixes = [".json_serializable.g.part"],
    deps = [":_stage_dto"],
)

dart_codegen(
    name = "_character_dto_g",
    package_name = _PKG,
    src = "lib/src/domain/model/character_dto.dart",
    generator_bin = "@rules_dart//dart/ext/_shared/combining_shim:bin",
    language_version = _LANG,
    output_suffixes = [".g.dart"],
    parts = [":_character_dto_json_part"],
)

# --- characters_list_api: retrofit (fork patch 0001) ------------------------
dart_codegen(
    name = "_characters_list_api_retrofit_part",
    package_name = _PKG,
    src = "lib/src/domain/api/characters_list_api.dart",
    generator_bin = "@rules_dart//dart/ext/retrofit:shim",
    language_version = _LANG,
    output_suffixes = [".retrofit.g.part"],
    deps = [
        ":_stage_dto",
        "//utility/mc_api_client",
        "@pub_deps//:dio",
        "@pub_deps//:injectable",
        "@pub_deps//:retrofit",
    ],
)

dart_codegen(
    name = "_characters_list_api_g",
    package_name = _PKG,
    src = "lib/src/domain/api/characters_list_api.dart",
    generator_bin = "@rules_dart//dart/ext/_shared/combining_shim:bin",
    language_version = _LANG,
    output_suffixes = [".g.dart"],
    parts = [":_characters_list_api_retrofit_part"],
)

# --- injectable (fork patch 0002) -------------------------------------------
injectable_package(
    name = "di_config",
    srcs = [
        "lib/src/domain/api/characters_list_api.dart",
        "lib/src/domain/repository/characters_list_repository.dart",
        "lib/src/presentation/bloc/character_preview_bloc.dart",
        "lib/src/presentation/bloc/characters_list_bloc.dart",
    ],
    init = _INIT,
    init_deps = ["//utility/mc_di"],
    language_version = _LANG,
    package_name = _PKG,
    shard_deps = [":_stage"],
)

# --- gen-l10n ---------------------------------------------------------------
# Outputs land beside the ARBs; the rule ignores l10n.yaml, so these attributes
# mirror it (IDE / pub path: `flutter: generate: true`, F-0023).
flutter_gen_l10n(
    name = "_l10n",
    arbs = glob(["lib/src/l10n/*.arb"]),
    nullable_getter = False,
    output_class = "CharactersListL10n",
    output_localization_file = "characters_list_l10n.dart",
    template_arb_file = "characters_list_en.arb",
)

filegroup(
    name = "arbs",
    srcs = glob(["lib/src/l10n/*.arb"]),
    visibility = ["//tool/l10n_check:__pkg__"],
)

_CODEGEN = [
    ":_character_freezed",
    ":_character_dto_freezed",
    ":_character_dto_g",
    ":_characters_list_api_g",
    ":_flow_state_freezed",
    ":_list_bloc_freezed",
    ":di_config",
    ":_l10n",
]
