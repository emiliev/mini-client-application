# T-0063 (P1-22): `settings_appearance`, the ST exemplar feature (plan 01
# §3.3). Phase D's buildgen emits this file; until then it is written by hand.
# It has the shape of store_home's (T-0056).
# No per-package analysis_options.yaml: the root file applies (F-0021).
#
# Every generator runs as a Bazel action; nothing generated is committed:
#   freezed      the flow state, the bloc state
#   injectable   1 shard + di_initializer.config.dart (fork patch 0002)
#   gen-l10n     lib/src/l10n/settings_appearance_l10n*.dart
#   BDD          test/feature/*.feature -> :bdd_test (fork patch 0003)
#
# No retrofit and no json: the preferences are app-wide, so their wire
# format and sync live in `utility/mc_appearance` (ADR-0013); this feature
# reads and changes them through the `AppearanceSettings` port.
#
# Staging (plan 03 §3.4, §4.7). Generators read only Flutter-free libraries
# (R15): `_stage` holds the hand-written pure files.
load("@rules_dart//dart:defs.bzl", "dart_codegen", "dart_library", "dart_test")
load("@rules_dart//dart/ext/injectable:defs.bzl", "injectable_package")
load("@rules_flutter//flutter:defs.bzl", "flutter_gen_l10n", "flutter_library", "flutter_test")
load("//tool/bazel:defs.bzl", "MC_GENERATED_DART", "mc_bdd_tests")

package(default_visibility = ["//visibility:private"])

_PKG = "settings_appearance"

_LANG = "3.13"  # the pubspec floor; codegen equals build_runner only with it (F-0011)

_INIT = "lib/src/di/di_initializer.dart"

# Pure-Dart deps of the hand-written, generator-read files.
_PURE_DEPS = [
    "//utility/mc_appearance",
    "//utility/mc_bloc_kit",
    "//utility/mc_di",
    "//utility/mc_monitoring",
    "//utility/mc_storage",
    "@pub_deps//:bloc",
    "@pub_deps//:freezed_annotation",
    "@pub_deps//:get_it",
    "@pub_deps//:injectable",
]

# The Flutter-free hand-written files: the analytics vocabulary, the
# navigator, the flow state, the bloc and the root-import list. Pages,
# widgets, the flow widget and l10n are Flutter.
_PURE_SRCS = glob(
    [
        "lib/src/di/flow_scope.dart",
        "lib/src/domain/**/*.dart",
        "lib/src/flow/settings_appearance_flow_state.dart",
        "lib/src/navigator/**/*.dart",
        "lib/src/presentation/bloc/**/*.dart",
    ],
    exclude = MC_GENERATED_DART,
)

# Generator input only (V3-18): never a dep of the package library or a test.
dart_library(
    name = "_stage",
    package_name = _PKG,
    srcs = _PURE_SRCS,
    language_version = _LANG,
    tags = [
        "no-dart-analyze",
        "no-dart-format",
    ],
    deps = _PURE_DEPS,
)

# --- freezed ----------------------------------------------------------------
_FREEZED = {
    "appearance_bloc": "lib/src/presentation/bloc/appearance_bloc.dart",
    "flow_state": "lib/src/flow/settings_appearance_flow_state.dart",
}

[dart_codegen(
    name = "_%s_freezed" % name,
    package_name = _PKG,
    src = src,
    generator_bin = "@rules_dart//dart/ext/freezed:shim",
    language_version = _LANG,
    output_suffixes = [".freezed.dart"],
    deps = [":_stage"],
) for name, src in _FREEZED.items()]

# --- injectable (fork patch 0002) -------------------------------------------
injectable_package(
    name = "di_config",
    srcs = ["lib/src/presentation/bloc/appearance_bloc.dart"],
    init = _INIT,
    init_deps = ["//utility/mc_di"],
    language_version = _LANG,
    package_name = _PKG,
    shard_deps = [":_stage"],
)

# --- gen-l10n ---------------------------------------------------------------
# Outputs land beside the ARBs; the rule ignores l10n.yaml, so these attributes
# mirror it (IDE / pub path: `flutter: generate: true`, F-0023).
flutter_gen_l10n(
    name = "_l10n",
    arbs = glob(["lib/src/l10n/*.arb"]),
    nullable_getter = False,
    output_class = "SettingsAppearanceL10n",
    output_localization_file = "settings_appearance_l10n.dart",
    template_arb_file = "settings_appearance_en.arb",
)

filegroup(
    name = "arbs",
    srcs = glob(["lib/src/l10n/*.arb"]),
    visibility = ["//tool/l10n_check:__pkg__"],
)

_CODEGEN = [
    ":_appearance_bloc_freezed",
    ":_flow_state_freezed",
    ":di_config",
    ":_l10n",
]

# --- the package library ----------------------------------------------------
_FLUTTER_DEPS = [
    "//utility/mc_analytics",
    "//utility/mc_ds_buttons",
    "//utility/mc_ds_feedback",
    "//utility/mc_ds_inputs",
    "//utility/mc_ds_navigation",
    "//utility/mc_ds_overlays",
    "//utility/mc_ds_theme",
    "//utility/mc_ds_tokens",
    "//utility/mc_feature_flow",
    "//utility/mc_l10n_core",
    "@pub_deps//:flutter",
    "@pub_deps//:flutter_bloc",
    "@pub_deps//:flutter_localizations",
    "@pub_deps//:intl",
]

flutter_library(
    name = "settings_appearance",
    srcs = glob(
        ["lib/**/*.dart"],
        # `tool/ide_sync` and `fvm flutter pub get` write the generated files
        # beside their sources for the IDE; Bazel builds its own copies.
        exclude = MC_GENERATED_DART,
    ) + _CODEGEN,
    language_version = _LANG,
    package_name = _PKG,
    visibility = ["//visibility:public"],
    deps = _PURE_DEPS + _FLUTTER_DEPS,
)

# --- tests (R6: BDD + contract + l10n; no solitary unit tests) -------------
# No goldens: features have none (PO 2026-11-27). AC4's visual checks are
# widget tests: the German and pseudo-locale BDD scenarios, and the density
# and theme tests in flow_scope_test.
_TEST_DEPS = [
    "//utility/mc_analytics",  # keep
    "//utility/mc_api_auth",
    "//utility/mc_appearance",
    "//utility/mc_di",
    "//utility/mc_ds_inputs",
    "//utility/mc_ds_navigation",  # keep
    "//utility/mc_ds_overlays",  # keep
    "//utility/mc_feature_flow",  # keep
    "//utility/mc_fixtures_identity",
    "//utility/mc_l10n_core",  # keep
    "//utility/mc_mocked_backend",  # keep
    "//utility/mc_session",  # keep
    "//utility/mc_storage",
    "@pub_deps//:dio",
    "@pub_deps//:mocktail",
]

mc_bdd_tests(
    name = "bdd_test",
    features = glob(["test/feature/*.feature"]),
    language_version = _LANG,
    lib = ":settings_appearance",
    package_name = _PKG,
    setup = "test/feature/util/settings_appearance_env.dart",
    steps = glob([
        "test/feature/step/**/*.dart",
        "test/feature/util/*.dart",
    ]),
    deps = _TEST_DEPS,
)

# The feature's contract with the app: its analytics vocabulary and the
# labels of every value of `mc_appearance` (the one src/ importer, R7).
flutter_test(
    name = "contract_test",
    size = "small",
    language_version = _LANG,
    main = "test/contract/settings_appearance_contract_test.dart",
    package_name = _PKG,
    deps = [
        ":settings_appearance",
        "//utility/mc_appearance",
        "//utility/mc_monitoring",
        "@pub_deps//:flutter",
        "@pub_deps//:flutter_test",
    ],
)

# R17: the hand-written root imports resolve every registration of the flow.
flutter_test(
    name = "flow_scope_test",
    size = "small",
    srcs = glob(["test/feature/util/*.dart"]),
    data = ["//utility/mc_ds_theme:fonts"],
    language_version = _LANG,
    main = "test/flow_scope_test.dart",
    package_name = _PKG,
    deps = _TEST_DEPS + [
        ":settings_appearance",
        "//utility/mc_ds_tokens",
        "//utility/mc_monitoring",
        "//utility/mc_test_utils",
        "@pub_deps//:flutter",
        "@pub_deps//:flutter_test",
    ],
)

# R4 and R15 conformance. The list of generator-read files is written from the
# same glob as :_stage, so the check cannot drift from the staging library.
genrule(
    name = "_pure_srcs_list",
    outs = ["test/architecture/pure_srcs.txt"],
    cmd = "cat > $@ <<'EOF'\n" + "\n".join(_PURE_SRCS) + "\nEOF",
)

dart_test(
    name = "architecture_test",
    size = "small",
    data = [
        "lib/settings_appearance.dart",
        ":_pure_srcs_list",
    ] + _PURE_SRCS,
    language_version = _LANG,
    main = "test/architecture/architecture_test.dart",
    package_name = _PKG,
    deps = ["@pub_deps//:test"],
)
