# Bazel
bazel-*
.bazelrc.user
# Device signing is per developer (plan 03 X8)
/device/

# Dart / Flutter tooling (fvm baselines, IDE, build_runner overlay scratch)
.dart_tool/
.fvm/
build/
coverage/
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/ephemeral/
# Written by `fvm flutter pub get` into members that have an ios/ dir; Bazel
# generates its own registrant and never reads these.
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Runner/GeneratedPluginRegistrant.*
*.iml
.idea/

# Generated code is never committed (R10 / D7); Bazel owns it.
# A future build_runner fallback (R28) adds explicit negations below.
*.g.dart
*.freezed.dart
# injectable's config and shards, where its builders write them (T-0032).
# The BDD generator writes only into bazel-out (`bazel-*` above), so no
# test/feature pattern: a hand-written test/feature/x_test.dart stays visible.
**/lib/src/di/*.config.dart
**/lib/**/*.injectable.json
**/lib/src/l10n/*_l10n.dart
**/lib/src/l10n/*_l10n_[a-z]*.dart
.bazelrc.user.tmp
**/.flutter-plugins-dependencies

# tool/ide_sync (T-0042) writes into the source tree for the IDE and
# `flutter run`; none of it may be committed. Bazel never reads it (see
# tool/checks/T-0042-AC4_safety.sh).
# R13: the environment's config, as `ide_sync --env <env>` bundles it.
app/**/assets/app_config.json
# The Xcode project `flutter run` needs, from `flutter create --platforms=ios`
# (apps carry only the Bazel runner files, F-0032), and what flutter writes.
**/ios/Runner.xcodeproj/
**/ios/Runner.xcworkspace/
**/ios/RunnerTests/
**/ios/Flutter/AppFrameworkInfo.plist
**/ios/Flutter/Debug.xcconfig
**/ios/Flutter/Release.xcconfig
**/ios/Runner/Runner-Bridging-Header.h
**/ios/Runner/Assets.xcassets/LaunchImage.imageset/
**/ios/Podfile
**/ios/Podfile.lock
.metadata
