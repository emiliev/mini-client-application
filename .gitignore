# Bazel
bazel-*
.bazelrc.user
# Device signing is per developer (plan 03 X8)
/device/

# Dart / Flutter tooling (fvm baselines, IDE, build_runner overlay scratch)
.dart_tool/
.fvm/
build/
coverage/
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/ephemeral/
# Written by `fvm flutter pub get` into members that have an ios/ dir; Bazel
# generates its own registrant and never reads these.
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Runner/GeneratedPluginRegistrant.*
*.iml
.idea/

# Generated code is never committed (R10 / D7); Bazel owns it.
# A future build_runner fallback (R28) adds explicit negations below.
*.g.dart
*.freezed.dart
**/lib/src/l10n/*_l10n.dart
**/lib/src/l10n/*_l10n_[a-z]*.dart
