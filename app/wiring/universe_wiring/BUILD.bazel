# T-0033: universe_wiring, the universe group's app layer (plan 01 §3.4).
#
# Generators run as Bazel actions; nothing generated is committed:
#   go_router_builder  src/routes/characters_routes.dart  (F-0007 workaround)
#   injectable         src/di/di_initializer.dart + the navigators' shard
#
# R15: the route file imports only `route_targets.dart`; the generators read
# `_stage` (the hand-written files they resolve imports through), never
# `route_targets_impl.dart`.
load("@rules_dart//dart:defs.bzl", "dart_codegen")
load("@rules_dart//dart/ext/injectable:defs.bzl", "injectable_package")
load("@rules_flutter//flutter:defs.bzl", "flutter_library", "flutter_test")

package(default_visibility = ["//app:__subpackages__"])

_PKG = "universe_wiring"

_LANG = "3.13"  # the pubspec floor (F-0011)

_ROUTES = "lib/src/routes/characters_routes.dart"

_INIT = "lib/src/di/di_initializer.dart"

_NAVIGATOR = "lib/src/navigators/characters_list_navigator_impl.dart"

_DEPS = [
    "//app/wiring/app_core",
    "//feature/characters/characters_list",
    "//utility/mc_di",
    "@pub_deps//:flutter",
    "@pub_deps//:get_it",
    "@pub_deps//:go_router",
    "@pub_deps//:injectable",
]

# Generator input only: the files the generators resolve imports through.
flutter_library(
    name = "_stage",
    package_name = _PKG,
    srcs = [
        "lib/src/flows/character_details_placeholder_flow.dart",
        "lib/src/routes/route_targets.dart",
    ],
    language_version = _LANG,
    tags = [
        "no-dart-analyze",
        "no-dart-format",
    ],
    deps = _DEPS,
)

# --- go_router_builder (F-0007 workaround: sky_engine turns summaries off) ---
dart_codegen(
    name = "_characters_routes_go_router_part",
    package_name = _PKG,
    src = _ROUTES,
    generator_bin = "@rules_dart//dart/ext/go_router:shim",
    language_version = _LANG,
    output_suffixes = [".go_router.g.part"],
    deps = [
        ":_stage",
        "@flutter_sky_engine//:sky_engine",
    ] + _DEPS,
)

dart_codegen(
    name = "_characters_routes_g",
    package_name = _PKG,
    src = _ROUTES,
    generator_bin = "@rules_dart//dart/ext/_shared/combining_shim:bin",
    language_version = _LANG,
    output_suffixes = [".g.dart"],
    parts = [":_characters_routes_go_router_part"],
)

# --- injectable (fork patch 0002) -------------------------------------------
injectable_package(
    name = "di_config",
    srcs = [_NAVIGATOR],
    init = _INIT,
    init_deps = ["//utility/mc_di"],
    language_version = _LANG,
    package_name = _PKG,
    shard_deps = [
        ":_stage",
        "@flutter_sky_engine//:sky_engine",
    ] + _DEPS,
)

_CODEGEN = [
    ":_characters_routes_g",
    ":di_config",
]

flutter_library(
    name = "universe_wiring",
    package_name = _PKG,
    srcs = glob(
        ["lib/**/*.dart"],
        exclude = [
            "**/*.g.dart",
            "**/*.config.dart",
        ],
    ) + _CODEGEN,
    language_version = _LANG,
    deps = _DEPS,
)

_TEST_DEPS = _DEPS + [
    ":universe_wiring",
    "@pub_deps//:flutter_test",
]

[flutter_test(
    name = t,
    size = "small",
    package_name = _PKG,
    language_version = _LANG,
    main = "test/%s.dart" % t,
    deps = _TEST_DEPS,
) for t in [
    "routes_test",
]]
