# T-0021 (P1-16): app_core, the shared app layer (plan 01 §3.4).
load("@rules_flutter//flutter:defs.bzl", "flutter_library", "flutter_test")
load("//tool/bazel:defs.bzl", "MC_GENERATED_DART")

package(default_visibility = ["//app:__subpackages__"])

_LANG = "3.13"

_DEPS = [
    "//utility/mc_analytics",
    "//utility/mc_api_auth",
    "//utility/mc_api_client",
    "//utility/mc_appearance",
    "//utility/mc_bloc_kit",
    "//utility/mc_config",
    "//utility/mc_di",
    "//utility/mc_ds_buttons",
    "//utility/mc_ds_feedback",
    "//utility/mc_ds_layout",
    "//utility/mc_ds_media",
    "//utility/mc_ds_overlays",
    "//utility/mc_ds_theme",
    "//utility/mc_ds_tokens",
    "//utility/mc_event_bus",
    "//utility/mc_feature_flags",
    "//utility/mc_formatters",
    "//utility/mc_fixtures_characters",
    "//utility/mc_fixtures_comics",
    "//utility/mc_fixtures_commerce",
    "//utility/mc_fixtures_discovery",
    "//utility/mc_fixtures_editorial",
    "//utility/mc_fixtures_identity",
    "//utility/mc_fixtures_library",
    "//utility/mc_fixtures_media",
    "//utility/mc_fixtures_platform",
    "//utility/mc_mocked_backend",
    "//utility/mc_monitoring",
    "//utility/mc_session",
    "//utility/mc_storage",
    "@pub_deps//:bloc",
    "@pub_deps//:dio",
    "@pub_deps//:flutter",
    "@pub_deps//:get_it",
    "@pub_deps//:go_router",
]

flutter_library(
    name = "app_core",
    package_name = "app_core",
    srcs = glob(["lib/**/*.dart"], exclude = MC_GENERATED_DART),
    language_version = _LANG,
    deps = _DEPS,
)

[flutter_test(
    name = t,
    size = "small",
    package_name = "app_core",
    language_version = _LANG,
    main = "test/%s.dart" % t,
    deps = _DEPS + [
        ":app_core",
        "@pub_deps//:flutter_test",
    ],
) for t in [
    "boot_test",
    "links_and_hooks_test",
    "router_ref_and_scheme_test",
    "formatters_root_test",
    "app_layer_test",
    "feature_flags_boot_test",
    "route_nesting_test",
    "router_observers_test",
]]

