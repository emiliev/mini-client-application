# T-0053-AC4: the app's screens through the shared analytics steps, over the
# test container (the session's backend harness and analytics sink).
mc_bdd_tests(
    name = "bdd_test",
    data = ["//utility/mc_fixtures_media:asset_files"],
    features = glob(["test/feature/*.feature"]),
    language_version = _LANG,
    lib = ":mini_client_lib",
    package_name = _PKG,
    setup = "test/feature/util/app_env.dart",
    steps = glob([
        "test/feature/step/**/*.dart",
        "test/feature/util/*.dart",
    ]),
    # The macro adds flutter, flutter_test and mc_test_utils itself.
    deps = [d for d in _RUNTIME_DEPS if d != "@pub_deps//:flutter"] + [
        "//utility/mc_fixtures_characters",
    ],
)

# --- The app (manual, R14) --------------------------------------------------
# The app rule carries no DartInfo, so its sources are listed again (as
# spike/hello does) instead of depending on :mini_client_lib.
flutter_application(
    name = "mini_client_app",
    package_name = _PKG,
    language_version = _LANG,
    srcs = [s for s in _HAND_WRITTEN if s != "lib/main.dart"] + _GENERATED,
    main = "lib/main.dart",
    assets = [":app_config_asset"],
    min_os_version = IOS_MINIMUM_OS_VERSION,
    tags = ["manual"],
    deps = _RUNTIME_DEPS + ["@rules_flutter//flutter:material_icons"],
)

flutter_ios_app(
    name = "mini_client_ios",
    application = ":mini_client_app",
    bundle_id = "com.emiliev.miniclient",
    tags = ["manual"],
)
