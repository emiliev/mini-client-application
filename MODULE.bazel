"mini-client: Tide-style Miniclient Marvel app built with ai_rules_dart / ai_rules_flutter (ADR-0008, plan 03 §1.1)."

module(name = "mini_client")

bazel_dep(name = "ai_rules_dart", version = "0.28.3", repo_name = "rules_dart")
bazel_dep(name = "ai_rules_flutter", version = "0.30.2", repo_name = "rules_flutter")
bazel_dep(name = "rules_apple", version = "5.2.0")
bazel_dep(name = "rules_swift", version = "4.1.2")
bazel_dep(name = "apple_support", version = "2.9.1")
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# Pinned commits (KD1). The patch queue (KD2, P3-02, tool/rules_fork.sh) is in `patches`.
git_override(
    module_name = "ai_rules_dart",
    commit = "e7163aab8f9171f54693cd1b99feb7d3cee9602d",  # v0.28.3
    remote = "https://github.com/Mivr/ai_rules_dart.git",
    patch_strip = 1,
    patches = [
        # tool/rules_fork.sh export prints the lines to paste here.
        # U-D-retrofit (T-0027): dart/ext/retrofit shim + retrofit_generator in the ext lock.
        "//third_party/rules_patches/ai_rules_dart:0001-feat-ext-add-a-retrofit_generator-shim-and-retrofit_.patch",
        # U-D-injectable (T-0028): dart/ext/injectable two-stage shim + vendored injectable_generator.
        "//third_party/rules_patches/ai_rules_dart:0002-ext-injectable-two-stage.patch",
        # U-D-bdd (T-0029): dart/ext/bdd hermetic bdd_widget_test generator.
        "//third_party/rules_patches/ai_rules_dart:0003-ext-bdd-generator.patch",
    ],
)

git_override(
    module_name = "ai_rules_flutter",
    commit = "876e263d65ca3eb33e4b05f9b0dc55affc5b3887",  # v0.30.2
    remote = "https://github.com/Mivr/ai_rules_flutter.git",
    patch_strip = 1,
    patches = [
        # tool/rules_fork.sh export prints the lines to paste here.
    ],
)

flutter = use_extension("@rules_flutter//flutter:extensions.bzl", "flutter")
flutter.toolchain(flutter_version = "3.47.7")
flutter.pub(
    name = "pub_deps",
    # dio and dio_web_adapter depend on each other; without this, rules_flutter
    # merges them into one Flutter target and pure-Dart closures reach
    # sky_engine (F-0019).
    cycle_breaks = {"dio": ["dio_web_adapter"]},
    lock = "//:pubspec.lock",  # no plugins, so no Podfile / SwiftPM inputs
)
use_repo(flutter, "flutter_ios_engine", "flutter_sky_engine", "flutter_toolchains", "pub_deps")

register_toolchains("@flutter_toolchains//:all")
