# T-0045 (U35): form scaffold, wizard stepper and field groups.
# Layering: this package must never depend on //utility/mc_feature_flow;
# T-0045-AC4 checks it with cquery (tool/checks/T-0045-AC4_layering.sh).
load("@rules_flutter//flutter:defs.bzl", "flutter_library", "flutter_test")
load("//tool/bazel:defs.bzl", "MC_GENERATED_DART")

# Public until the P3-06 package_group exists (follow-up: restrict to layers).
package(default_visibility = ["//visibility:public"])

_LANG = "3.13"

_DEPS = [
    "//utility/mc_ds_buttons",
    "//utility/mc_ds_inputs",
    "//utility/mc_ds_layout",
    "//utility/mc_ds_theme",
    "//utility/mc_ds_tokens",
    "//utility/mc_forms",
    "@pub_deps//:flutter",
]

flutter_library(
    name = "mc_ds_forms",
    srcs = glob(["lib/**/*.dart"], exclude = MC_GENERATED_DART),
    language_version = _LANG,
    package_name = "mc_ds_forms",
    deps = _DEPS,
)

_TEST_DEPS = _DEPS + [
    ":mc_ds_forms",
    "//utility/mc_api_errors",
    "//utility/mc_prelude",
    "//utility/mc_test_utils",
    "@pub_deps//:flutter_test",
]

_DATA = ["//utility/mc_ds_theme:fonts"]

flutter_test(
    name = "forms_test",
    size = "small",
    data = _DATA,
    language_version = _LANG,
    main = "test/forms_test.dart",
    package_name = "mc_ds_forms",
    deps = _TEST_DEPS,
)

flutter_test(
    name = "golden_test",
    size = "medium",
    data = _DATA + glob(["test/goldens/**"], allow_empty = True),
    language_version = _LANG,
    main = "test/golden_test.dart",
    package_name = "mc_ds_forms",
    tags = ["golden"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = _TEST_DEPS,
)
