# T-0031 (U31): paged list and grid bound to PagedState.
load("@rules_flutter//flutter:defs.bzl", "flutter_library", "flutter_test")

# Public until the P3-06 package_group exists (follow-up: restrict to layers).
package(default_visibility = ["//visibility:public"])

_LANG = "3.13"

_DEPS = [
    "//utility/mc_ds_buttons",
    "//utility/mc_ds_feedback",
    "//utility/mc_ds_layout",
    "//utility/mc_ds_theme",
    "//utility/mc_ds_tokens",
    "//utility/mc_paging",
    "@pub_deps//:flutter",
]

flutter_library(
    name = "mc_ds_lists",
    srcs = glob(["lib/**/*.dart"]),
    language_version = _LANG,
    package_name = "mc_ds_lists",
    deps = _DEPS,
)

_TEST_DEPS = _DEPS + [
    ":mc_ds_lists",
    "//utility/mc_api_errors",
    "//utility/mc_ds_cards",
    "//utility/mc_ds_media",
    "//utility/mc_fixtures_media",
    "//utility/mc_media",
    "//utility/mc_test_utils",
    "@pub_deps//:flutter_test",
]

_DATA = [
    "//utility/mc_ds_theme:fonts",
    "//utility/mc_fixtures_media:asset_files",
]

[flutter_test(
    name = t,
    size = "small",
    srcs = ["test/shared_behaviour.dart", "test/support.dart"],
    data = _DATA,
    language_version = _LANG,
    main = "test/%s.dart" % t,
    package_name = "mc_ds_lists",
    deps = _TEST_DEPS,
) for t in [
    "paged_list_test",
    "paged_grid_test",
]]

flutter_test(
    name = "golden_test",
    size = "medium",
    srcs = ["test/support.dart"],
    data = _DATA + glob(["test/goldens/**"], allow_empty = True),
    language_version = _LANG,
    main = "test/golden_test.dart",
    package_name = "mc_ds_lists",
    tags = ["golden"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = _TEST_DEPS,
)
