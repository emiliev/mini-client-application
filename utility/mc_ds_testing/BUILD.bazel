load("@rules_flutter//flutter:defs.bzl", "flutter_library", "flutter_test")

# Test-only: the golden harness (real fonts, iOS platform, theme matrix).
# Production packages must never depend on this or on flutter_test.
package(default_visibility = ["//visibility:public"])

flutter_library(
    name = "mc_ds_testing",
    testonly = True,
    srcs = glob(["lib/**/*.dart"]),
    language_version = "3.13",
    package_name = "mc_ds_testing",
    deps = [
        "//utility/mc_ds_theme",
        "//utility/mc_ds_tokens",
        "@pub_deps//:flutter",
        "@pub_deps//:flutter_test",
    ],
)

flutter_test(
    name = "fonts_test",
    size = "small",
    data = ["//utility/mc_ds_theme:fonts"],
    language_version = "3.13",
    main = "test/fonts_test.dart",
    package_name = "mc_ds_testing",
    deps = [
        ":mc_ds_testing",
        "//utility/mc_ds_theme",
        "//utility/mc_ds_tokens",
        "@pub_deps//:flutter",
        "@pub_deps//:flutter_test",
    ],
)
