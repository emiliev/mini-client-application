load("@rules_flutter//flutter:defs.bzl", "flutter_library", "flutter_test")

# Public until the P3-06 package_group exists (follow-up: restrict to layers).
package(default_visibility = ["//visibility:public"])

flutter_library(
    name = "mc_ds_layout",
    srcs = glob(["lib/**/*.dart"]),
    language_version = "3.13",
    package_name = "mc_ds_layout",
    deps = [
        "//utility/mc_ds_tokens",
        "@pub_deps//:flutter",
    ],
)

flutter_test(
    name = "layout_test",
    size = "small",
    language_version = "3.13",
    main = "test/layout_test.dart",
    package_name = "mc_ds_layout",
    deps = [
        ":mc_ds_layout",
        "//utility/mc_ds_theme",
        "//utility/mc_ds_tokens",
        "@pub_deps//:flutter",
        "@pub_deps//:flutter_test",
    ],
)

flutter_test(
    name = "golden_test",
    size = "medium",
    data = ["//utility/mc_ds_theme:fonts"] + glob(["test/goldens/**"], allow_empty = True),
    language_version = "3.13",
    main = "test/golden_test.dart",
    package_name = "mc_ds_layout",
    tags = ["golden"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = [
        "//utility/mc_ds_testing",
        ":mc_ds_layout",
        "//utility/mc_ds_theme",
        "//utility/mc_ds_tokens",
        "@pub_deps//:flutter",
        "@pub_deps//:flutter_test",
    ],
)
