# T-0038 (P1-08 subset, U41): the comics domain of the mocked backend. Data plus
# small pure-Dart handlers (R3). The library is pure Dart (AC4); the tests may
# use Flutter and the other fixture domains to check the cross-links.
load("@rules_dart//dart:defs.bzl", "dart_library")
load("@rules_flutter//flutter:defs.bzl", "flutter_test")

package(default_visibility = ["//visibility:public"])

_LANG = "3.13"

dart_library(
    name = "mc_fixtures_comics",
    package_name = "mc_fixtures_comics",
    srcs = glob(["lib/**/*.dart"]),
    language_version = _LANG,
    deps = [
        "//utility/mc_media",
        "//utility/mc_mocked_backend",
    ],
)

_TEST_DEPS = [
    ":mc_fixtures_comics",
    "//utility/mc_fixtures_characters",
    "//utility/mc_fixtures_media",
    "//utility/mc_media",
    "//utility/mc_mocked_backend",
    "@pub_deps//:dio",
    "@pub_deps//:flutter_test",
]

flutter_test(
    name = "comics_test",
    package_name = "mc_fixtures_comics",
    language_version = _LANG,
    size = "small",
    main = "test/comics_test.dart",
    deps = _TEST_DEPS,
)

flutter_test(
    name = "provider_contract_test",
    package_name = "mc_fixtures_comics",
    language_version = _LANG,
    size = "small",
    srcs = ["test/contract/snapshot_cases.dart"],
    data = glob(["test/contract/snapshots/*.json"]) + [
        "CONTRACT.md",
        "fixtures/routes.json",
        "//utility/mc_fixtures_media:asset_files",
    ],
    main = "test/contract/provider_contract_test.dart",
    deps = _TEST_DEPS,
)

flutter_test(
    name = "fixture_sets_test",
    package_name = "mc_fixtures_comics",
    language_version = _LANG,
    size = "small",
    main = "test/fixture_sets_test.dart",
    deps = _TEST_DEPS,
)
