# T-0030 (U14): ApiImage, McImageResolver and McMediaScope.
#
# Two libraries of one package, split so pure-Dart code (the mocked backend
# fixtures, and through them the api client's tests) never pulls Flutter into
# its closure (F-0029):
#   :mc_media        pure Dart; ApiImage and the resolver interface
#   :mc_media_scope  Flutter; McMediaScope, its own barrel mc_media_scope.dart
load("@rules_dart//dart:defs.bzl", "dart_library", "dart_test")
load("@rules_flutter//flutter:defs.bzl", "flutter_library", "flutter_test")

package(default_visibility = ["//visibility:public"])

_LANG = "3.13"

dart_library(
    name = "mc_media",
    srcs = [
        "lib/mc_media.dart",
        "lib/src/api_image.dart",
        "lib/src/image_resolver.dart",
    ],
    language_version = _LANG,
    package_name = "mc_media",
)

flutter_library(
    name = "mc_media_scope",
    srcs = [
        "lib/mc_media_scope.dart",
        "lib/src/media_scope.dart",
    ],
    language_version = _LANG,
    package_name = "mc_media",
    deps = [
        ":mc_media",
        "@pub_deps//:flutter",
    ],
)

dart_test(
    name = "api_image_test",
    size = "small",
    language_version = _LANG,
    main = "test/api_image_test.dart",
    package_name = "mc_media",
    deps = [
        ":mc_media",
        "@pub_deps//:test",
    ],
)

flutter_test(
    name = "media_scope_test",
    size = "small",
    language_version = _LANG,
    main = "test/media_scope_test.dart",
    package_name = "mc_media",
    deps = [
        ":mc_media",
        ":mc_media_scope",
        "@pub_deps//:flutter",
        "@pub_deps//:flutter_test",
    ],
)

# AC7: the pure library imports no Flutter.
dart_test(
    name = "purity_test",
    size = "small",
    data = [
        "lib/mc_media.dart",
        "lib/src/api_image.dart",
        "lib/src/image_resolver.dart",
    ],
    language_version = _LANG,
    main = "test/purity_test.dart",
    package_name = "mc_media",
    deps = ["@pub_deps//:test"],
)
