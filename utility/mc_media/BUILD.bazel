# T-0030 (U14): ApiImage and the McImageResolver interface. Pure Dart, one barrel.
# McMediaScope moved to //utility/mc_ds_media in T-0031 (F-0029 follow-up), so
# fixtures and pure tests never see Flutter through this package.
load("@rules_dart//dart:defs.bzl", "dart_library", "dart_test")

package(default_visibility = ["//visibility:public"])

_LANG = "3.13"

dart_library(
    name = "mc_media",
    srcs = [
        "lib/mc_media.dart",
        "lib/src/api_image.dart",
        "lib/src/image_resolver.dart",
    ],
    language_version = _LANG,
    package_name = "mc_media",
)

dart_test(
    name = "api_image_test",
    size = "small",
    language_version = _LANG,
    main = "test/api_image_test.dart",
    package_name = "mc_media",
    deps = [
        ":mc_media",
        "@pub_deps//:test",
    ],
)

# AC7: the pure library imports no Flutter.
dart_test(
    name = "purity_test",
    size = "small",
    data = [
        "lib/mc_media.dart",
        "lib/src/api_image.dart",
        "lib/src/image_resolver.dart",
    ],
    language_version = _LANG,
    main = "test/purity_test.dart",
    package_name = "mc_media",
    deps = ["@pub_deps//:test"],
)
