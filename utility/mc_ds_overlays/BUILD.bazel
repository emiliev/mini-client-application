# T-0058: McDialog, McSheet, choice sheets, McMenuButton, McTooltip, toasts.
# Layering: this package must never depend on //utility/mc_feature_flow or
# //utility/mc_paging; T-0058-AC5 checks it with cquery.
load("@rules_flutter//flutter:defs.bzl", "flutter_library", "flutter_test")
load("//tool/bazel:defs.bzl", "MC_GENERATED_DART")

# Public until the P3-06 package_group exists (follow-up: restrict to layers).
package(default_visibility = ["//visibility:public"])

_LANG = "3.13"

_DEPS = [
    "//utility/mc_ds_buttons",
    "//utility/mc_ds_layout",
    "//utility/mc_ds_theme",
    "//utility/mc_ds_tokens",
    "@pub_deps//:flutter",
]

flutter_library(
    name = "mc_ds_overlays",
    srcs = glob(["lib/**/*.dart"], exclude = MC_GENERATED_DART),
    language_version = _LANG,
    package_name = "mc_ds_overlays",
    deps = _DEPS,
)

_TEST_DEPS = _DEPS + [
    ":mc_ds_overlays",
    "//utility/mc_test_utils",
    "@pub_deps//:flutter_test",
]

_DATA = ["//utility/mc_ds_theme:fonts"]

flutter_test(
    name = "overlays_test",
    size = "small",
    data = _DATA,
    language_version = _LANG,
    main = "test/overlays_test.dart",
    package_name = "mc_ds_overlays",
    deps = _TEST_DEPS,
)

flutter_test(
    name = "golden_test",
    size = "medium",
    data = _DATA + glob(["test/goldens/**"], allow_empty = True),
    language_version = _LANG,
    main = "test/golden_test.dart",
    package_name = "mc_ds_overlays",
    tags = ["golden"],
    target_compatible_with = ["@platforms//os:macos"],
    deps = _TEST_DEPS,
)
