# T-0023 (P1-05): the shared Dio. Pure Dart (R15); the mocked backend is a test-only dep.
load("@rules_dart//dart:defs.bzl", "dart_codegen", "dart_library", "dart_test")
load("//tool/bazel:defs.bzl", "MC_GENERATED_DART")

# T-0032 (P-053): the `ApiPage<T>` envelope, json_serializable with
# genericArgumentFactories, generated as a Bazel action (no build_runner).
dart_codegen(
    name = "_api_page_json_part",
    package_name = "mc_api_client",
    language_version = "3.13",
    src = "lib/src/api_page.dart",
    generator_bin = "@rules_dart//dart/ext/json_serializable:shim",
    output_suffixes = [".json_serializable.g.part"],
    deps = ["@pub_deps//:json_annotation"],
)

dart_codegen(
    name = "_api_page_g",
    package_name = "mc_api_client",
    language_version = "3.13",
    src = "lib/src/api_page.dart",
    generator_bin = "@rules_dart//dart/ext/_shared/combining_shim:bin",
    output_suffixes = [".g.dart"],
    parts = [":_api_page_json_part"],
)

dart_library(
    name = "mc_api_client",
    package_name = "mc_api_client",
    srcs = glob(["lib/**/*.dart"], exclude = MC_GENERATED_DART) + [":_api_page_g"],
    language_version = "3.13",
    visibility = ["//visibility:public"],
    deps = [
        "//utility/mc_api_errors",
        "//utility/mc_config",
        "//utility/mc_di",
        "//utility/mc_monitoring",
        "//utility/mc_prelude",
        "@pub_deps//:dio",
        "@pub_deps//:get_it",
        "@pub_deps//:json_annotation",
    ],
)

dart_test(
    name = "api_client_test",
    size = "small",
    package_name = "mc_api_client",
    language_version = "3.13",
    main = "test/api_client_test.dart",
    deps = [
        ":mc_api_client",
        "//utility/mc_api_errors",
        "//utility/mc_config",
        "//utility/mc_di",
        "//utility/mc_fixtures_characters",
        "//utility/mc_mocked_backend",
        "//utility/mc_monitoring",
        "//utility/mc_prelude",
        "@pub_deps//:dio",
        "@pub_deps//:test",
    ],
)

