# T-0060 (P1-10 subset, U47): the trivia slice of the editorial domain of the mocked backend.
# Data plus small pure-Dart handlers (R3). The library is pure Dart (AC5); the
# tests may use Flutter and the other fixture domains to check the cross-links.
load("@rules_dart//dart:defs.bzl", "dart_library")
load("@rules_flutter//flutter:defs.bzl", "flutter_test")
load("//tool/bazel:defs.bzl", "MC_GENERATED_DART")

package(default_visibility = ["//visibility:public"])

# The scoring spec: trivia_quiz's Scenario Outline copies its worked
# examples, and a test there checks they are the same rows (T-0064-AC6).
exports_files(["CONTRACT.md"])

_LANG = "3.13"

dart_library(
    name = "mc_fixtures_editorial",
    package_name = "mc_fixtures_editorial",
    srcs = glob(["lib/**/*.dart"], exclude = MC_GENERATED_DART),
    language_version = _LANG,
    deps = [
        "//utility/mc_fixtures_characters",
        "//utility/mc_fixtures_comics",
        "//utility/mc_fixtures_identity",
        "//utility/mc_mocked_backend",
    ],
)

_TEST_DEPS = [
    ":mc_fixtures_editorial",
    "//utility/mc_fixtures_characters",
    "//utility/mc_fixtures_comics",
    "//utility/mc_fixtures_identity",
    "//utility/mc_fixtures_media",
    "//utility/mc_media",
    "//utility/mc_mocked_backend",
    "@pub_deps//:dio",
    "@pub_deps//:flutter_test",
]

_SUPPORT = [
    "test/oracle.dart",
    "test/support.dart",
]

flutter_test(
    name = "determinism_test",
    package_name = "mc_fixtures_editorial",
    language_version = _LANG,
    size = "small",
    srcs = _SUPPORT,
    main = "test/determinism_test.dart",
    deps = _TEST_DEPS,
)

flutter_test(
    name = "scoring_test",
    package_name = "mc_fixtures_editorial",
    language_version = _LANG,
    size = "small",
    srcs = _SUPPORT,
    data = ["CONTRACT.md"],
    main = "test/scoring_test.dart",
    deps = _TEST_DEPS,
)

flutter_test(
    name = "validation_test",
    package_name = "mc_fixtures_editorial",
    language_version = _LANG,
    size = "small",
    srcs = _SUPPORT,
    main = "test/validation_test.dart",
    deps = _TEST_DEPS,
)

flutter_test(
    name = "provider_contract_test",
    package_name = "mc_fixtures_editorial",
    language_version = _LANG,
    size = "small",
    srcs = _SUPPORT + ["test/contract/snapshot_cases.dart"],
    data = glob(["test/contract/snapshots/*.json"]) + [
        "CONTRACT.md",
        "fixtures/routes.json",
        "//utility/mc_fixtures_media:asset_files",
    ],
    main = "test/contract/provider_contract_test.dart",
    deps = _TEST_DEPS,
)

flutter_test(
    name = "fixture_sets_test",
    package_name = "mc_fixtures_editorial",
    language_version = _LANG,
    size = "small",
    srcs = _SUPPORT,
    main = "test/fixture_sets_test.dart",
    deps = _TEST_DEPS,
)
