+    // remove after deprecation period
+    if (microPackageModulesBefore.isEmpty) {
+      microPackageModulesBefore.addAll(
+        _getMicroPackageModulesMapped(
+          annotation.peek('externalPackageModules'),
+          typeResolver,
+        ),
+      );
+    }
