+# injectable: two-stage shim over a vendored injectable_generator 3.1.3
+# (third_party/injectable_generator, without lib/lean_builder/; see VENDORED.md).
+#
+#   stage 1  shim_json    per-file `dart_codegen`        <src>.injectable.json
+#   stage 2  shim_config  `dart_aggregate_codegen` over  <init>.config.dart
+#                         the stage-1 shards (asset_deps)
+#
+# `injectable_package` in defs.bzl wires both stages.
+
+load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
+load("//dart:defs.bzl", "dart_binary", "dart_library", "dart_test")
+
+exports_files(
+    ["defs.bzl"],
+    visibility = ["//visibility:public"],
+)
+
+bzl_library(
+    name = "defs",
+    srcs = ["defs.bzl"],
+    visibility = ["//visibility:public"],
+    deps = ["//dart:defs"],
+)
+
+# The Builder wrappers both shims run (empty shard -> `[]`; a config stage
+# that generates nothing fails instead of writing an empty file).
+dart_library(
+    name = "injectable_shims",
+    package_name = "rules_dart_ext_injectable",
+    srcs = ["lib/injectable_shims.dart"],
+    language_version = "3.11",
+    deps = [
+        "@ext_pub_deps//:analyzer",
+        "@ext_pub_deps//:build",
+        "@ext_pub_deps//:crypto",
+        "@ext_pub_deps//:glob",
+        "@ext_pub_deps//:package_config",
+    ],
+)
+
+dart_binary(
+    name = "shim_json",
+    srcs = ["shim_json.dart"],
+    code_assets_from_deps = False,
+    compile_mode = "kernel",
+    launcher = True,
+    main = "shim_json.dart",
+    visibility = ["//visibility:public"],
+    deps = [
+        ":injectable_shims",
+        "//dart/ext:builder_shim",
+        "//dart/ext/injectable/third_party/injectable_generator",
+        "@ext_pub_deps//:build",
+    ],
+)
+
+dart_binary(
+    name = "shim_config",
+    srcs = ["shim_config.dart"],
+    code_assets_from_deps = False,
+    compile_mode = "kernel",
+    launcher = True,
+    main = "shim_config.dart",
+    visibility = ["//visibility:public"],
+    deps = [
+        ":injectable_shims",
+        "//dart/ext:builder_shim",
+        "//dart/ext/injectable/third_party/injectable_generator",
+        "@ext_pub_deps//:build",
+    ],
+)
+
+dart_test(
+    name = "injectable_shims_test",
+    size = "small",
+    package_name = "rules_dart_ext_injectable",
+    language_version = "3.11",
+    main = "test/injectable_shims_test.dart",
+    deps = [
+        ":injectable_shims",
+        "@ext_pub_deps//:build",
+        "@ext_pub_deps//:glob",
+        "@ext_pub_deps//:test",
+    ],
+)
diff --git a/dart/ext/injectable/defs.bzl b/dart/ext/injectable/defs.bzl
new file mode 100644
index 00000000..e1d0586b
--- /dev/null
+++ b/dart/ext/injectable/defs.bzl
@@ -0,0 +1,179 @@
+"""Two-stage injectable code generation (an aggregate builder).
+
+injectable_generator runs in two stages under build_runner: a per-library
+Builder writes `<file>.injectable.json`, then the `@InjectableInit` file's
+Builder reads every shard with `findAssets` and writes `<init>.config.dart`.
+`injectable_package` maps that onto rules_dart:
+
+  1. one `dart_codegen` per annotated file (`shim_json`), deps = `shard_deps`;
+  2. one `dart_aggregate_codegen` over the init file (`shim_config`), with the
+     shards as `asset_deps` and deps = `annotation_deps` + `init_deps`.
+
+Keep `init_deps` to what the init file itself imports. `dart_aggregate_codegen`
+stages every same-package sibling it finds in `deps`, so a library holding
+the package's hand-written sources there would make each of them an input of
+the aggregate. With only the shards as package inputs, an edit that leaves
+every shard byte-identical (a method body, say) is a cache hit for the
+aggregate action.
+
+The generator is a vendored injectable_generator 3.1.3 without its optional
+lean_builder integration (`third_party/injectable_generator/VENDORED.md`).
+"""
+
+load("@rules_dart//dart:defs.bzl", "dart_aggregate_codegen", "dart_codegen")
+
+visibility("public")
+
+_SHIM_JSON = Label("//dart/ext/injectable:shim_json")
+_SHIM_CONFIG = Label("//dart/ext/injectable:shim_config")
+
+def _token(path):
+    t = path
+    if t.startswith("lib/"):
+        t = t[len("lib/"):]
+    if t.endswith(".dart"):
+        t = t[:-len(".dart")]
+    return t.replace("/", "_").replace(".", "_").replace("-", "_")
+
+def injectable_shards(
+        name,
+        srcs,
+        package_name = "",
+        language_version = "",
+        deps = [],
+        annotation_deps = ["@pub_deps//:injectable", "@pub_deps//:get_it"],
+        config = "",
+        **kwargs):
+    """Declares the stage-1 shard targets, one per source.
+
+    Args:
+      name: Prefix of the per-source targets (`_<name>_<token>_inj`).
+      srcs: `.dart` files that carry `@injectable`, `@singleton`,
+        `@lazySingleton`, `@module` or similar annotations.
+      package_name: Dart package name of the sources.
+      language_version: Dart language version of the package (`<major>.<minor>`).
+      deps: Libraries the sources import. Same-package siblings in them are
+        staged for the analyzer.
+      annotation_deps: The injectable and get_it libraries of the consumer's hub.
+      config: injectable_generator options as JSON (`auto_register`,
+        `class_name_pattern`, `file_name_pattern`).
+      **kwargs: Forwarded to every `dart_codegen` (for example `tags`).
+
+    Returns:
+      The labels of the shard targets, for `injectable_config`'s `shards`.
+    """
+    shards = []
+    by_token = {}
+    for src in srcs:
+        token = _token(src)
+        if token in by_token:
+            fail("injectable_shards(%s): %r and %r map to the same target name " % (name, by_token[token], src) +
+                 "suffix %r; rename one of the files or split the call." % token)
+        by_token[token] = src
+        target = "_{}_{}_inj".format(name, token)
+        dart_codegen(
+            name = target,
+            src = src,
+            generator_bin = _SHIM_JSON,
+            output_suffixes = [".injectable.json"],
+            package_name = package_name,
+            language_version = language_version,
+            deps = deps + [d for d in annotation_deps if d not in deps],
+            config = config,
+            **kwargs
+        )
+        shards.append(":" + target)
+    return shards
+
+def injectable_config(
+        name,
+        init,
+        shards,
+        package_name = "",
+        language_version = "",
+        deps = [],
+        annotation_deps = ["@pub_deps//:injectable", "@pub_deps//:get_it"],
+        output = None,
+        **kwargs):
+    """Declares the stage-2 aggregate that writes `<init>.config.dart`.
+
+    Fails the build instead of writing an empty file when `init` holds no
+    resolvable `@InjectableInit`.
+
+    Args:
+      name: Target name; its default output is the `.config.dart`.
+      init: The `.dart` file with the `@InjectableInit` function.
+      shards: The stage-1 shard targets (`injectable_shards`).
+      package_name: Dart package name of `init`.
+      language_version: Dart language version of the package.
+      deps: Further libraries the init file imports. Never the package's own
+        hand-written library: that would make every source an input.
+      annotation_deps: The injectable and get_it libraries of the consumer's hub.
+      output: Output path; defaults to `init` with `.dart` -> `.config.dart`.
+      **kwargs: Forwarded to `dart_aggregate_codegen`.
+    """
+    if not init.endswith(".dart"):
+        fail("injectable_config: init must be a .dart file, got %r" % init)
+    dart_aggregate_codegen(
+        name = name,
+        srcs = [init],
+        asset_deps = shards,
+        generator_bin = _SHIM_CONFIG,
+        outputs = [output or init[:-len(".dart")] + ".config.dart"],
+        package_name = package_name,
+        language_version = language_version,
+        deps = annotation_deps + [d for d in deps if d not in annotation_deps],
+        **kwargs
+    )
+
+def injectable_package(
+        name,
+        srcs,
+        init,
+        package_name = "",
+        language_version = "",
+        shard_deps = [],
+        init_deps = [],
+        annotation_deps = ["@pub_deps//:injectable", "@pub_deps//:get_it"],
+        config = "",
+        output = None,
+        **kwargs):
+    """Both stages: shards for `srcs`, then the `.config.dart` for `init`.
+
+    `name` is the aggregate target; add it to the package library's `srcs`.
+
+    Args:
+      name: Target name of the `.config.dart` aggregate.
+      srcs: Annotated `.dart` files (one shard each).
+      init: The `@InjectableInit` file.
+      package_name: Dart package name.
+      language_version: Dart language version of the package.
+      shard_deps: Deps of the shard actions (usually a staging library of the
+        package's hand-written sources plus what they import).
+      init_deps: Further deps of the aggregate: only what `init` imports.
+      annotation_deps: The injectable and get_it libraries of the consumer's hub.
+      config: injectable_generator options as JSON, for the shard stage.
+      output: `.config.dart` path; defaults to beside `init`.
+      **kwargs: Forwarded to every generated target.
+    """
+    shards = injectable_shards(
+        name = name,
+        srcs = srcs,
+        package_name = package_name,
+        language_version = language_version,
+        deps = shard_deps,
+        annotation_deps = annotation_deps,
+        config = config,
+        **kwargs
+    )
+    injectable_config(
+        name = name,
+        init = init,
+        shards = shards,
+        package_name = package_name,
+        language_version = language_version,
+        deps = init_deps,
+        annotation_deps = annotation_deps,
+        output = output,
+        **kwargs
+    )
diff --git a/dart/ext/injectable/lib/injectable_shims.dart b/dart/ext/injectable/lib/injectable_shims.dart
new file mode 100644
index 00000000..c418d026
--- /dev/null
+++ b/dart/ext/injectable/lib/injectable_shims.dart
@@ -0,0 +1,280 @@
+/// Wrappers that make injectable_generator's two Builders safe to run as
+/// rules_dart shims (`dart/ext/injectable/shim_json.dart`, `shim_config.dart`).
+///
+/// The shim writes every declared output, and writes it empty when the
+/// Builder emits nothing (`builder_shim.dart` `_routeDeclaredOutputs`). For
+/// injectable that is wrong in both stages:
+///
+/// - Stage 1 (`.injectable.json`): the generator returns `null` for a library
+///   with no injectable classes. An empty shard is not JSON, and the config
+///   stage's `jsonDecode` would throw on it. [InjectableShardBuilder] writes
+///   `[]` instead, which the config stage treats exactly like build_runner's
+///   missing shard.
+/// - Stage 2 (`.config.dart`): when `@InjectableInit` does not resolve (for
+///   example `package:injectable` is missing from `deps`), the generator emits
+///   nothing and the shim would write an empty `.config.dart`, which only
+///   fails later as an "undefined name" in the init file.
+///   [InjectableConfigBuilder] fails the action instead, naming the init file.
+///
+/// Both also run the generator against [BuildRunnerLibrariesStep], whose
+/// `resolver.libraries` yields libraries in build_runner's order. The shim's
+/// own `Resolver.libraries` yields the staged same-package files and then each
+/// package's `lib/<name>.dart`. injectable records the *first* library that
+/// exports a type as its import and the rest as `otherImports`, and the rest
+/// feed the hash that orders registrations, so under the shim's order a
+/// package barrel can become the import and a third-party type (`Dio`) loses
+/// its `otherImports`, which reorders `.config.dart` (F-0028).
+library;
+
+import 'dart:async';
+import 'dart:collection';
+import 'dart:convert';
+
+import 'package:analyzer/dart/ast/ast.dart';
+import 'package:analyzer/dart/element/element.dart';
+import 'package:build/build.dart';
+import 'package:crypto/crypto.dart';
+import 'package:glob/glob.dart';
+import 'package:package_config/package_config_types.dart';
+
+/// The JSON written for a library whose generator output is empty.
+const String emptyShard = '[]';
+
+/// Runs injectable_generator's per-library Builder and writes [emptyShard]
+/// to every allowed output the inner Builder did not write.
+class InjectableShardBuilder implements Builder {
+  /// Wraps [inner], normally `injectableBuilder(options)`.
+  InjectableShardBuilder(this.inner);
+
+  /// The wrapped Builder.
+  final Builder inner;
+
+  @override
+  Map<String, List<String>> get buildExtensions => inner.buildExtensions;
+
+  @override
+  Future<void> build(BuildStep buildStep) async {
+    await inner.build(BuildRunnerLibrariesStep(buildStep));
+    for (final AssetId output in buildStep.allowedOutputs) {
+      if (!await buildStep.canRead(output)) {
+        await buildStep.writeAsString(output, emptyShard);
+      }
+    }
+  }
+}
+
+/// Runs injectable_generator's config Builder. Fails when a staged shard is
+/// not a JSON list, and when the Builder writes no `.config.dart`.
+class InjectableConfigBuilder implements Builder {
+  /// Wraps [inner], normally `injectableConfigBuilder(options)`.
+  InjectableConfigBuilder(
+    this.inner, {
+    this.shardGlob = 'lib/**.injectable.json',
+  });
+
+  /// The wrapped Builder.
+  final Builder inner;
+
+  /// The shards checked before [inner] runs (injectable's default
+  /// `generateForDir: ['lib']`).
+  final String shardGlob;
+
+  @override
+  Map<String, List<String>> get buildExtensions => inner.buildExtensions;
+
+  @override
+  Future<void> build(BuildStep buildStep) async {
+    await for (final AssetId shard in buildStep.findAssets(Glob(shardGlob))) {
+      final String text = await buildStep.readAsString(shard);
+      Object? decoded;
+      try {
+        decoded = jsonDecode(text);
+      } on FormatException {
+        decoded = null;
+      }
+      if (decoded is! List) {
+        final String what = text.trim().isEmpty ? 'empty' : 'not a JSON list';
+        throw StateError(
+          'injectable config: shard ${shard.path} is $what. Shards must come '
+          'from @rules_dart//dart/ext/injectable:shim_json, which writes [] '
+          'for a library with no injectable classes.',
+        );
+      }
+    }
+    await inner.build(BuildRunnerLibrariesStep(buildStep));
+    final List<AssetId> missing = [
+      for (final AssetId output in buildStep.allowedOutputs)
+        if (output.path.endsWith('.config.dart') &&
+            !await buildStep.canRead(output))
+          output,
+    ];
+    if (missing.isNotEmpty) {
+      final String paths = missing.map((AssetId id) => id.path).join(', ');
+      throw StateError(
+        'injectable config: ${buildStep.inputId.path} generated nothing for '
+        '$paths. The file needs an annotation that resolves to '
+        "package:injectable's @InjectableInit; check that the injectable "
+        "annotation library is in the target's deps.",
+      );
+    }
+  }
+}
+
+/// A [BuildStep] that forwards everything to [delegate] except `resolver`,
+/// which is a [BuildRunnerLibrariesResolver].
+class BuildRunnerLibrariesStep implements BuildStep {
+  /// Wraps [delegate].
+  BuildRunnerLibrariesStep(this.delegate);
+
+  /// The shim's build step.
+  final BuildStep delegate;
+
+  @override
+  late final Resolver resolver = BuildRunnerLibrariesResolver(
+    delegate.resolver,
+    delegate.inputId,
+  );
+
+  @override
+  AssetId get inputId => delegate.inputId;
+
+  @override
+  Future<LibraryElement> get inputLibrary => delegate.inputLibrary;
+
+  @override
+  Iterable<AssetId> get allowedOutputs => delegate.allowedOutputs;
+
+  @override
+  Future<PackageConfig> get packageConfig => delegate.packageConfig;
+
+  @override
+  Future<bool> canRead(AssetId id) => delegate.canRead(id);
+
+  @override
+  Future<Digest> digest(AssetId id) => delegate.digest(id);
+
+  @override
+  Stream<AssetId> findAssets(Glob glob) => delegate.findAssets(glob);
+
+  @override
+  Future<List<int>> readAsBytes(AssetId id) => delegate.readAsBytes(id);
+
+  @override
+  Future<String> readAsString(AssetId id, {Encoding encoding = utf8}) =>
+      delegate.readAsString(id, encoding: encoding);
+
+  @override
+  Future<void> writeAsBytes(AssetId id, FutureOr<List<int>> bytes) =>
+      delegate.writeAsBytes(id, bytes);
+
+  @override
+  Future<void> writeAsString(
+    AssetId id,
+    FutureOr<String> contents, {
+    Encoding encoding = utf8,
+  }) => delegate.writeAsString(id, contents, encoding: encoding);
+
+  @override
+  Future<T> fetchResource<T>(Resource<T> resource) =>
+      delegate.fetchResource(resource);
+
+  @override
+  T trackStage<T>(
+    String label,
+    T Function() action, {
+    bool isExternal = false,
+  }) => delegate.trackStage(label, action, isExternal: isExternal);
+
+  @override
+  void reportUnusedAssets(Iterable<AssetId> ids) =>
+      delegate.reportUnusedAssets(ids);
+}
+
+/// A [Resolver] whose [libraries] follow build_runner 2.16's
+/// `BuildStepResolver.libraries`: a breadth-first walk from the input library
+/// over each library's imports, then exports (first fragment only), with SDK
+/// libraries yielded before the rest. Everything else is [delegate]'s.
+///
+/// One difference remains: build_runner yields *every* public SDK library
+/// first, in the SDK's order; this yields only the SDK libraries the walk
+/// reaches, in walk order. That matters only for an element that two SDK
+/// libraries export.
+class BuildRunnerLibrariesResolver implements Resolver {
+  /// Wraps [delegate]; the walk starts at [entryPoint].
+  BuildRunnerLibrariesResolver(this.delegate, this.entryPoint);
+
+  /// The shim's resolver.
+  final Resolver delegate;
+
+  /// The build step's input.
+  final AssetId entryPoint;
+
+  @override
+  Stream<LibraryElement> get libraries async* {
+    final List<LibraryElement> walk = await _walk();
+    yield* Stream.fromIterable(walk.where((l) => l.isInSdk));
+    yield* Stream.fromIterable(walk.where((l) => !l.isInSdk));
+  }
+
+  Future<List<LibraryElement>> _walk() async {
+    final result = <LibraryElement>[];
+    if (!await delegate.isLibrary(entryPoint)) return result;
+    final LibraryElement input = await delegate.libraryFor(
+      entryPoint,
+      allowSyntaxErrors: true,
+    );
+    final seen = <LibraryElement>{input};
+    final toVisit = Queue<LibraryElement>()..add(input);
+    while (toVisit.isNotEmpty) {
+      final LibraryElement current = toVisit.removeFirst();
+      result.add(current);
+      final Set<LibraryElement> toCrawl = current.firstFragment.libraryImports
+          .map((import) => import.importedLibrary)
+          .followedBy(
+            current.firstFragment.libraryExports.map(
+              (export) => export.exportedLibrary,
+            ),
+          )
+          .nonNulls
+          .where((library) => !seen.contains(library))
+          .toSet();
+      toVisit.addAll(toCrawl);
+      seen.addAll(toCrawl);
+    }
+    return result;
+  }
+
+  @override
+  Future<LibraryElement?> findLibraryByName(String libraryName) async {
+    await for (final LibraryElement library in libraries) {
+      if (library.name == libraryName) return library;
+    }
+    return null;
+  }
+
+  @override
+  Future<bool> isLibrary(AssetId assetId) => delegate.isLibrary(assetId);
+
+  @override
+  Future<AstNode?> astNodeFor(Fragment fragment, {bool resolve = false}) =>
+      delegate.astNodeFor(fragment, resolve: resolve);
+
+  @override
+  Future<CompilationUnit> compilationUnitFor(
+    AssetId assetId, {
+    bool allowSyntaxErrors = false,
+  }) => delegate.compilationUnitFor(
+    assetId,
+    allowSyntaxErrors: allowSyntaxErrors,
+  );
+
+  @override
+  Future<LibraryElement> libraryFor(
+    AssetId assetId, {
+    bool allowSyntaxErrors = false,
+  }) => delegate.libraryFor(assetId, allowSyntaxErrors: allowSyntaxErrors);
+
+  @override
+  Future<AssetId> assetIdForElement(Element element) =>
+      delegate.assetIdForElement(element);
+}
