@@ -0,0 +1,147 @@
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:build/build.dart';
+import 'package:glob/glob.dart';
+import 'package:rules_dart_ext_injectable/injectable_shims.dart';
+import 'package:test/test.dart';
+
+/// A BuildStep over an in-memory asset map; only what the wrappers use.
+class _FakeStep implements BuildStep {
+  _FakeStep(this.inputId, this.allowedOutputs, [Map<AssetId, String>? assets])
+    : assets = assets ?? {};
+
+  @override
+  final AssetId inputId;
+
+  @override
+  final Iterable<AssetId> allowedOutputs;
+
+  final Map<AssetId, String> assets;
+
+  @override
+  Future<bool> canRead(AssetId id) async => assets.containsKey(id);
+
+  @override
+  Future<String> readAsString(AssetId id, {Encoding encoding = utf8}) async =>
+      assets[id] ?? (throw AssetNotFoundException(id));
+
+  @override
+  Stream<AssetId> findAssets(Glob glob) =>
+      Stream.fromIterable(assets.keys.where((id) => glob.matches(id.path)));
+
+  @override
+  Future<void> writeAsString(
+    AssetId id,
+    FutureOr<String> contents, {
+    Encoding encoding = utf8,
+  }) async {
+    assets[id] = await contents;
+  }
+
+  @override
+  dynamic noSuchMethod(Invocation invocation) => super.noSuchMethod(invocation);
+}
+
+/// A Builder that writes [output] (or nothing, when null) to every allowed output.
+class _Inner implements Builder {
+  _Inner(this.output);
+
+  final String? output;
+  var runs = 0;
+
+  @override
+  Map<String, List<String>> get buildExtensions => const {
+    '.dart': ['.out'],
+  };
+
+  @override
+  Future<void> build(BuildStep buildStep) async {
+    runs++;
+    if (output == null) return;
+    for (final AssetId id in buildStep.allowedOutputs) {
+      await buildStep.writeAsString(id, output!);
+    }
+  }
+}
+
+void main() {
+  final input = AssetId('pkg', 'lib/src/a.dart');
+  final shard = AssetId('pkg', 'lib/src/a.injectable.json');
+  final init = AssetId('pkg', 'lib/di.dart');
+  final config = AssetId('pkg', 'lib/di.config.dart');
+
+  group('InjectableShardBuilder', () {
+    test('T-0028-AC4 writes [] when the generator returns nothing', () async {
+      final step = _FakeStep(input, [shard]);
+      await InjectableShardBuilder(_Inner(null)).build(step);
+      expect(step.assets[shard], '[]');
+      expect(jsonDecode(step.assets[shard]!), isEmpty);
+    });
+
+    test('keeps the generator output when there is one', () async {
+      final step = _FakeStep(input, [shard]);
+      await InjectableShardBuilder(_Inner('[{"type":1}]')).build(step);
+      expect(step.assets[shard], '[{"type":1}]');
+    });
+
+    test('forwards buildExtensions', () {
+      expect(InjectableShardBuilder(_Inner(null)).buildExtensions, {
+        '.dart': ['.out'],
+      });
+    });
+  });
+
+  group('InjectableConfigBuilder', () {
+    test('T-0028-AC4 accepts [] shards and writes the config', () async {
+      final step = _FakeStep(init, [config], {shard: '[]'});
+      await InjectableConfigBuilder(_Inner('// config')).build(step);
+      expect(step.assets[config], '// config');
+    });
+
+    test('T-0028-AC4 fails when the init file generates nothing', () async {
+      final step = _FakeStep(init, [config], {shard: '[]'});
+      await expectLater(
+        InjectableConfigBuilder(_Inner(null)).build(step),
+        throwsA(
+          isA<StateError>().having(
+            (e) => e.message,
+            'message',
+            allOf(contains('lib/di.dart'), contains('@InjectableInit')),
+          ),
+        ),
+      );
+      expect(step.assets.containsKey(config), isFalse);
+    });
+
+    test('fails naming an empty shard before running the generator', () async {
+      final inner = _Inner('// config');
+      final step = _FakeStep(init, [config], {shard: ''});
+      await expectLater(
+        InjectableConfigBuilder(inner).build(step),
+        throwsA(
+          isA<StateError>().having(
+            (e) => e.message,
+            'message',
+            allOf(contains(shard.path), contains('empty')),
+          ),
+        ),
+      );
+      expect(inner.runs, 0);
+    });
+
+    test('fails naming a shard that is not a JSON list', () async {
+      final step = _FakeStep(init, [config], {shard: '{"a":1}'});
+      await expectLater(
+        InjectableConfigBuilder(_Inner('// config')).build(step),
+        throwsA(
+          isA<StateError>().having(
+            (e) => e.message,
+            'message',
+            contains('not a JSON list'),
+          ),
+        ),
+      );
+    });
+  });
+}
