index 00000000..e6bbaa10
--- /dev/null
+++ b/dart/ext/injectable/shim_config.dart
@@ -0,0 +1,13 @@
+/// injectable stage 2: the `@InjectableInit` file's `.config.dart`, built
+/// from the stage-1 shards staged as `asset_deps`.
+library;
+
+import 'package:build/build.dart';
+import 'package:injectable_generator/builder.dart' show injectableConfigBuilder;
+import 'package:rules_dart_ext/worker_entry.dart';
+import 'package:rules_dart_ext_injectable/injectable_shims.dart';
+
+Builder _configBuilder(BuilderOptions options) =>
+    InjectableConfigBuilder(injectableConfigBuilder(options));
+
+Future<void> main(List<String> args) => shimMain(args, _configBuilder);
