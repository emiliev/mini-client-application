+    final Reference returnRefer;
+    if (isMicroPackage) {
+      returnRefer = TypeReference(
+        (b) => b
+          ..symbol = 'FutureOr'
+          ..url = 'dart:async'
+          ..types.add(refer('void')),
+      );
+    } else {
+      returnRefer = useAsyncModifier
+          ? TypeReference(
+              (b) => b
