+    if (dep.isAsync || hasAsyncDep) {
+      funcReferName = 'singletonAsync';
+    } else if (dep.dependsOn.isNotEmpty) {
+      funcReferName = 'singletonWithDependencies';
+    } else {
+      funcReferName = 'singleton';
+    }
