new file mode 100644
index 00000000..142a15e6
--- /dev/null
+++ b/dart/ext/retrofit/BUILD.bazel
@@ -0,0 +1,32 @@
+load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
+load("//dart:defs.bzl", "dart_binary")
+
+exports_files(
+    ["defs.bzl"],
+    visibility = ["//visibility:public"],
+)
+
+bzl_library(
+    name = "defs",
+    srcs = ["defs.bzl"],
+    visibility = ["//visibility:public"],
+    deps = [
+        "//dart/ext/_shared:defs",
+    ],
+)
+
+# Shim binary for the retrofit_generator Builder. SharedPartBuilder; produces
+# .retrofit.g.part shards (combining to .g.dart happens in a separate step).
+dart_binary(
+    name = "shim",
+    srcs = ["shim.dart"],
+    code_assets_from_deps = False,
+    compile_mode = "kernel",
+    launcher = True,
+    main = "shim.dart",
+    visibility = ["//visibility:public"],
+    deps = [
+        "//dart/ext:builder_shim",
+        "@ext_pub_deps//:retrofit_generator",
+    ],
+)
diff --git a/dart/ext/retrofit/defs.bzl b/dart/ext/retrofit/defs.bzl
new file mode 100644
index 00000000..f315e640
--- /dev/null
+++ b/dart/ext/retrofit/defs.bzl
@@ -0,0 +1,57 @@
+"""Convenience macro for the retrofit_generator builder."""
+
+load("@rules_dart//dart/ext/_shared:defs.bzl", "shared_part_library")
+
+visibility("public")
+
+def retrofit_library(
+        name,
+        srcs,
+        package_name = "",
+        language_version = "",
+        deps = [],
+        annotation_dep = "@pub_deps//:retrofit",
+        config = "",
+        **kwargs):
+    """Declares a `dart_library` completed by the `retrofit_generator` builder.
+
+    Generates one `.retrofit.g.part` shard per source, merges the shards into
+    `<src>.g.dart`, and wraps the sources and the merged output in a `dart_library`.
+
+    The generated client calls `package:dio` and the `fromJson` / `toJson` of every
+    model type a method takes or returns, so `deps` must reach `dio` and the model
+    libraries for the analyzer to resolve those types.
+
+    Args:
+      name: Name of the wrapping `dart_library` target; the per-source codegen targets
+        derive their names from it.
+      srcs: The `.dart` source files that carry `@RestApi` annotations. Each one gets
+        its own codegen action.
+      package_name: Dart package name, matching the consumer's `pubspec.yaml` `name:`.
+        Defaults to the last component of the Bazel package path.
+      language_version: Dart language version of the package in `<major>.<minor>` form.
+        Defaults to empty, which leaves the version unstated, as for a hand-written
+        `dart_library`.
+      deps: Additional `dart_library` targets the sources import, such as `dio` and
+        the model libraries. The annotation dependency is added automatically.
+        Defaults to none.
+      annotation_dep: Label of the runtime annotation library the sources import; it is
+        added to `deps`. Defaults to `@pub_deps//:retrofit`.
+      config: Builder options as a JSON string handed to the generator, standing in for
+        the `options:` of a `build.yaml`, for example `'{"format_output": false}'`.
+        Defaults to empty, which uses the builder's own defaults.
+      **kwargs: Further attributes forwarded to the wrapping `dart_library`, such as
+        `visibility` or `tags`.
+    """
+    shared_part_library(
+        name = name,
+        srcs = srcs,
+        package_name = package_name,
+        language_version = language_version,
+        shim = "@rules_dart//dart/ext/retrofit:shim",
+        part_suffix = ".retrofit.g.part",
+        annotation_dep = annotation_dep,
+        deps = deps,
+        config = config,
+        **kwargs
+    )
