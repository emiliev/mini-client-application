diff --git a/dart/tests/retrofit_library_direct_test.bzl b/dart/tests/retrofit_library_direct_test.bzl
new file mode 100644
index 00000000..a7461073
--- /dev/null
+++ b/dart/tests/retrofit_library_direct_test.bzl
@@ -0,0 +1,39 @@
+"""Direct `rules_testing` test for the `retrofit_library` macro.
+
+`retrofit_library` wraps a `dart_library` around two `dart_codegen` targets per source:
+one runs the retrofit_generator shim and emits the `.retrofit.g.part` shard, the other
+merges that shard into `<src>.g.dart`. The test pins the wrapping library's
+providers and both codegen targets' providers and actions.
+"""
+
+load("@rules_testing//lib:analysis_test.bzl", "analysis_test")
+load("//dart/ext/retrofit:defs.bzl", "retrofit_library")
+load(":ext_direct_helpers.bzl", "ANNOTATIONS", "LANGUAGE_VERSION", "PACKAGE", "expect_shared_part", "shared_part_targets", "source_of")
+
+visibility(["//dart/..."])
+
+def _retrofit_library_test(env, targets):
+    """Asserts the providers and the codegen actions `retrofit_library` declares."""
+    expect_shared_part(env, targets, "retrofit", ".retrofit.g.part", "*retrofit/shim*")
+
+def retrofit_library_direct_test_suite(name):
+    """Declares the direct test of `retrofit_library`.
+
+    Args:
+      name: Name of the generated `test_suite`.
+    """
+    retrofit_library(
+        name = name + "_subject",
+        srcs = [source_of("retrofit")],
+        annotation_dep = ANNOTATIONS,
+        language_version = LANGUAGE_VERSION,
+        package_name = PACKAGE,
+        tags = ["manual"],
+    )
+    analysis_test(
+        name = name + "_test",
+        attr_values = {"size": "small"},
+        impl = _retrofit_library_test,
+        targets = shared_part_targets(name, "retrofit"),
+    )
+    native.test_suite(name = name, tests = [":" + name + "_test"])
